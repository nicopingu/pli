# Profil m1-ultra, famille qwen3_5 (Qwen3.8 dense, 27B) : réglages de production de PLI 3.6.0.
PLI_ATTENTION_LIGNE=15000
PLI_CROISE_DENSE=1
PLI_ADMISSION_PETITES=8000
PLI_LECTURE_DEPLIE=f16
PLI_LECTURE_DEPLIE_MLP=t
PLI_ATTENTION_ATTEC=1
PLI_LECTURE_DEPLIE_NOYAU=1
PLI_LECTURE_DEPLIE_NN=1
PLI_ATTENTION_GEMM=1
PLI_ATTENTION_ATTM=1
# 13/10/2026 : sur le 27B, PLI_ATTENTION_LIGNE et PLI_ATTENTION_ATTEC ne servent plus que de repli (attm sert toute ligne d'écriture)
PLI_ATTENTION_F16=1
# 15/10/2026 : PLI 3.2.0 (P2) : fragments bf16 et poids rangés pour l'écriture ; PLI_RANGE demande PLI_LECTURE_DEPLIE et PLI_LECTURE_DEPLIE_NOYAU
PLI_XF_BF16=1
PLI_RANGE=1
# 16/10/2026 : PLI 3.3.0 (SP1, V3) : FFN partagé avec le Neural Engine pendant la lecture ; PLI_ANE_FFN demande PLI_LECTURE_DEPLIE=f16 et PLI_LECTURE_DEPLIE_MLP=t
PLI_ANE_FFN=1
# 16/10/2026 : PLI 3.4.0 (SP1 deux blocs, V3) : part du Neural Engine en deux programmes épinglés sur les blocs 1 et 3, 18 unités
PLI_ANE_BLOCS=2
PLI_ANE_FFN_UNITES=18
# 17/10/2026 : PLI 3.4.2 : rappel v2 (pli/rappel.py), brouillons recopiés des demandes finies, même texte produit
PLI_RAPPEL=1
# 17/10/2026 : PLI 3.5.0 : lecture réduite de l'attention d'écriture à 10 % des pavés, passée par attm (V3)
PLI_ATTENTION_REDUITE=10
