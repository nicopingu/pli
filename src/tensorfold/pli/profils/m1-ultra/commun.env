# Profil m1-ultra : réglages communs de PLI, mesurés sur Mac Studio M1 Ultra 64 Go (2 Neural Engine).
# Chargé par `pli serve --profile m1-ultra` (ou PLI_PROFIL=m1-ultra). Une variable déjà présente dans l'environnement l'emporte.
# Réglages propres à la machine (à mettre dans l'environnement, pas ici) : PLI_HOTES_ADMIS, PLI_EVENEMENTS.
PLI_ARBITRE=1
PLI_TOURS_ENTRE_LECTURES=100000
PLI_MORCEAU_COUCHES=4
PLI_HEURES=1
# 3.4.1 : garde Host/Origin, 403 sur un Host non local ou un Origin non admis
PLI_GARDE_HOTE=1
