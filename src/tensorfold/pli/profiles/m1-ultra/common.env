# Profile m1-ultra, settings for every model. Measured on a Mac Studio M1 Ultra, 64 GB, two Neural Engine blocks.
# Loaded by `pli serve --profile m1-ultra` (or PLI_PROFILE=m1-ultra). A variable already set in the environment wins.
# Settings that name this machine go in the environment, not here: PLI_ALLOWED_HOSTS, PLI_EVENTS.
# Cost arbiter: learns the cost of a round and picks the copy width and the number of drafts. At most 100,000 decode
# rounds between two prompt chunks. While another request writes, the reading of a prompt chunk yields every 4 layers.
# Arrival and end times of each request in the log.
PLI_ARBITER=1
PLI_ROUNDS_BETWEEN_PREFILLS=100000
PLI_CHUNK_LAYERS=4
PLI_LOG_TIMES=1
# Host/Origin guard: answer 403 to a request whose Host is not local or whose Origin is not allowed.
PLI_HOST_GUARD=1
# A finished reply is kept and served again if the client reconnects.
PLI_KEEP_REPLY=1
