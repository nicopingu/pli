# Profile m1-ultra, family qwen3_5 (Qwen3.8 dense, 27B): the production settings of the validated machine.
# Each setting is described in docs/switches.md. A variable already set in the environment wins.
# Fallback decode attention, used only where attm (below) does not apply: one MLX call per row from 15,000 keys.
PLI_ATTENTION_PER_ROW=15000
# Prompt reading may yield to decode rounds on the dense model (see PLI_CHUNK_LAYERS in common.env); a request of at
# most 8,000 tokens is admitted ahead of a request held back at admission.
PLI_INTERLEAVE_DENSE=1
PLI_ADMIT_SMALL=8000
# Prompt reading: 4-bit weights unpacked to f16 before the product, the MLP computed transposed, a one-pass unpacking
# kernel, and the bf16 projections computed in nn form. PLI_ATTENTION_ATTEC: single-launch decode attention, another
# fallback of attm.
PLI_PREFILL_UNPACK=f16
PLI_PREFILL_UNPACK_MLP=t
PLI_ATTENTION_ATTEC=1
PLI_PREFILL_UNPACK_KERNEL=1
PLI_PREFILL_UNPACK_NN=1
# Prompt attention through MLX's GEMM kernel with tuned tiles; decode attention through PLI's attm kernel for every row.
PLI_ATTENTION_GEMM=1
PLI_ATTENTION_ATTM=1
# Prompt attention products in f16.
PLI_ATTENTION_F16=1
# Decode kernels: bf16 fragments, and weights and scales laid out again for the decode kernel (needs the two
# PLI_PREFILL_UNPACK settings above).
PLI_XF_BF16=1
PLI_RELAYOUT=1
# Part of each FFN layer runs on the Neural Engine while the GPU reads the prompt (needs PLI_PREFILL_UNPACK=f16 and
# PLI_PREFILL_UNPACK_MLP=t).
PLI_ANE_FFN=1
# The Neural Engine part is split into two programs, one on each Neural Engine block, 18 units of 512 channels in all.
PLI_ANE_BLOCKS=2
PLI_ANE_FFN_UNITS=18
# Recall drafts: tokens copied from finished requests, checked by the model (same text).
PLI_RECALL=1
# Reduced decode attention on long contexts: reads the 10% of 32-key pages with the highest score, plus a recent tail.
PLI_ATTENTION_REDUCED=10
# attm reads keys in slices of 128 for calls of at most 12,288 keys.
PLI_ATTM_SHORT=12288
# The Neural Engine weights are requantized on the CPU, with 8 threads, instead of on the GPU.
PLI_ANE_REQUANT_CPU=1
PLI_ANE_REQUANT_THREADS=8
# The Neural Engine is kept awake between two layers; the number of its units depends on the chunk size
# (rows:units).
PLI_ANE_KEEPAWAKE=1
PLI_ANE_STEPS=256:14,512:16,1536:18
# A small GPU computation every 500 ms between requests keeps the weights wired; the last 16 prompt tokens are read
# with the chunk before.
PLI_HEARTBEAT_MS=500
PLI_MERGE_TAIL=16
# One 8-row tile per threadgroup in the exact row kernel; reduced attention anchored every 32 positions (the text no
# longer depends on the drafts), its page choice kept for 4 rounds.
PLI_TILES_PER_GROUP=1
PLI_REDUCED_ANCHOR=32
PLI_REDUCED_ROUNDS=4
# Hybrid draft (DFlash2 and the 27B's MTP head): at most 7 MTP drafts per round; the MTP head keeps its last 2,048 rows.
# It also needs PLI_HYBRID=1 and PLI_MTP_HEAD=<4-bit head file> in the environment: see the "Profile m1-ultra"
# section of the README.
PLI_MTP_DRAFTS=7
PLI_MTP_WINDOW=2048
# Kapitsa's 8-row verify GEMM for rounds of up to 128 rows.
PLI_V8=1
# Checkpoints keep a length instead of a copy of the KV cache.
PLI_KV_SHARING=1
# With the hybrid draft, a prompt of at most 3 messages (system, question, reply) drafts with DFlash2 alone.
PLI_HYBRID_MESSAGES=3
# Draft trees (KFlash) verified through attm, DFlash2 trees in the hybrid draft, only for short questions and only
# while the chain keeps fewer than 4.5 tokens per round; DeltaNet kernel for trees in mode 3.
PLI_KFLASH=1
PLI_TREES_ATTM=1
PLI_HYBRID_TREES=1
PLI_TREE_DELTANET=3
PLI_TREES_SHORT_ONLY=1
PLI_TREES_TOKEN_THRESHOLD=4.5
# Copy of the context or DFlash2 chain, learned per stream; extended draft lists (the list shipped with PLI: a bare file
# name is looked up next to the package).
PLI_HEAD_BEFORE_COPY=3
PLI_EXTENDED_DRAFT_LIST=extended-list-2048.txt
# Draft kernels (attention, stacked projections, q and k norms with RoPE in one kernel, top-16 split, block
# projections laid out), attm fragments loaded by simdgroup, 8-row tables prepared in parallel, and the snapshot on disk
# read again at the first slice of a resumed prompt.
PLI_DRAFT_ATTN=1
PLI_DRAFT_STACK=1
PLI_DRAFT_QKR=1
PLI_DRAFT_TOPK=1
PLI_RELAYOUT_DRAFT=1
PLI_ATTM_LOAD=1
PLI_V8_PREP2=1
PLI_REREAD_DISK=1
# Reduced attention, anchored, also for prompt chunks of up to 2,047 rows beyond 65,536 tokens of context.
PLI_S3B=1
PLI_S3B_THRESHOLD=65536
# MLX command buffers of at most 500 MB and 100 operations. MLX reads these two when it starts, before any profile is
# applied, so they go in the server's environment (install.sh sets them), not here:
#   MLX_MAX_MB_PER_BUFFER=500 MLX_MAX_OPS_PER_BUFFER=100
