# Machine variables for tools/pli-profil. Copy this file to ~/.config/pli/machine.env (or to machine.env
# in the launch profiles folder), then only change what differs. An environment variable always takes precedence.
# "~" is your home directory. The values below are the launcher defaults.

# Data directory: conversation snapshots, produced images and videos, logs, written configurations.
PLI_DONNEES=~/pli
# pli command installed by install.sh (otherwise "pli" found in the PATH).
PLI_BIN=~/pli/venv/bin/pli
# Listening address and port (0.0.0.0: the entire local network; then remember --api-key, see docs/usage-expert.md).
PLI_HOTE=127.0.0.1
PLI_PORT=8080

# General model: Hugging Face repository (downloaded on first launch) or local folder.
PLI_MODELE=mlx-community/Qwen3.8-27B-4bit
# Drafter: auto (DFlash2 if downloaded), none, or a folder.
PLI_BROUILLON=auto
# Files written by pli setup (the launcher only uses them if they exist).
PLI_TETE_MTP=~/pli/models/mtp-head-4bit.safetensors
PLI_CARTE_A1=~/pli/models/qwen38_27b_d2048.npz
# Model for the petite-machine profile.
PLI_PETIT_MODELE=prism-ml/Ternary-Bonsai-2-27B-mlx-2bit

# Voice: Python environment with mlx-audio (python3 -m venv ~/pli/venvs/mlx-audio, then pip install mlx-audio).
PLI_VENV_AUDIO=~/pli/venvs/mlx-audio
# Images: Python environment with mflux (python3 -m venv ~/pli/venvs/mflux, then pip install mflux).
PLI_VENV_IMAGE=~/pli/venvs/mflux
PLI_MODELE_IMAGE=~/pli/modeles-image/Qwen-Image-2.1-mflux-8bit
# Video: compiled h3 program (https://github.com/antirez/h3.c) and MiniMax-H3 model folder.
PLI_H3=~/pli/h3.c/h3
PLI_MODELE_VIDEO=~/pli/modeles-video/MiniMax-H3
# LoRA (creation-lora profile) and video LoRA fusion tool (a Python with numpy, and tools/pli-lora-fusion).
# Image LoRA already converted for mflux: tools/pli-lora-image INPUT OUTPUT (see docs/quick-usage.md).
PLI_LORA_IMAGE=~/pli/lora/lightning-v2rl-r64.safetensors
PLI_LORA_VIDEO=~/pli/lora/minimax_h3_fl2v_turbo_8step_v1.1_768p_bf16.safetensors
PLI_FUSION_PYTHON=~/pli/venv/bin/python
# PLI_FUSION_SCRIPT=~/pli-source/tools/pli-lora-fusion     (default: tools/pli-lora-fusion from the repository)

# Clone of the PLI repository (audio and image child processes, tools). Default: the repository containing tools/pli-profil.
# PLI_DEPOT=~/pli-source
