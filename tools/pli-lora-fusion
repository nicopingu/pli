#!/usr/bin/env python3
"""pli-lora-fusion: fusion of LoRA / LoKr into the MiniMax-H3 transformer (native format read by h3.c).

    pli-lora-fusion MODELE SORTIE --lora FICHIER[@FORCE] [--lora ...] [--essai] [--qkv auto|comfy|natif]

MODEL: model directory (contains FL2VA/transformer). OUTPUT: missing or empty directory; it receives a complete model
where only the touched transformer files are rewritten, the rest as links to MODEL, and fusion_lora_h3.json
(model, transformer, LoRA and forces) which allows the PLI video child process (gen/fils_video.py) to recognize a fusion
already done. The video child process calls this tool itself (key "fusion" in its catalog: python, script); it can
also be run manually. --essai verifies keys and shapes without writing anything. Exit codes: 0 done,
2 refused (nothing written), 3 calculation not finished.

Target: <modele>/FL2VA/transformer (or Ref2VA/transformer, or transformer/ if this directory
carries the native names blocks.N.attn.qkv_proj.weight). The names come from h3_dit.c
(load_block, lines 517-522) and the HF index FL2VA/transformer/model.safetensors.index.json.

Calculation: W' = W + force * (alpha/rank) * B @ A, in float32, reloaded by row blocks,
then rounded to nearest even to the original dtype (bf16 for the 4 matrices of the blocks).
Dependency: numpy only (no torch or safetensors: header and writing done by hand).
--essai n'a besoin d'aucune dependance.

qkv_proj layout (13/11/2026): the native FL2VA file (read as-is by h3.c) arranges qkv
interleaved by head, row h*384 + p*128 + d (p = 0 q, 1 k, 2 v; h3_shaders.metal:313). The base
ComfyUI (Comfy-Org/MiniMax-H3 54472221, minimax_h3_fl2va_bf16) and therefore the LoRAs trained on it
(keys diffusion_model.* or lora_unet_*) arrange qkv contiguous, row p*7168 + h*128 + d (verified by
bytes on blocks.0 and token_refiner.blocks.0). fc1, fc2, out_proj: identical to the byte.
Without permutation, the qkv delta of a Comfy LoRA falls on the wrong rows, without error.
--qkv auto (default): comfy for diffusion_model.* / lora_unet_* keys, native otherwise.

Format PEFT diffusers (14/11/2026, Turbo lightx2v) : cles transformer_blocks.N.attn.to_q|to_k|to_v|to_out.0,
transformer_blocks.N.ff.net.0.proj|ff.net.2 and token_refiner.refiner_blocks.N.* (suffix .lora_A.default.weight),
alpha in __metadata__["alpha"] (no alpha tensor; refused if missing). Correspondence:
  to_q / to_k / to_v  -> blocks.N.attn.qkv_proj: three deltas (rank r each) placed each on its rows
                         natives h*384 + p*128 + d (p = 0 q, 1 k, 2 v), ligne LoRA h*128 + d ;
  to_out.0            -> attn.out_proj ; ff.net.2 -> mlp.fc2 (identiques) ;
  ff.net.0.proj       -> mlp.fc1 : diffusers [valeur ; gate], natif [gate ; valeur] (h3_shaders.metal:473-474,
                         and Turbo comfyui swi_glu_mapping metadata): native row n <- LoRA row (n + F) % 2F;
  token_refiner.refiner_blocks.N -> token_refiner.blocks.N; any other target module: refused.
"""
import argparse, json, math, os, re, shutil, struct, subprocess, sys, time

DT = {"F32": 4, "F16": 2, "BF16": 2}
KOHYA = re.compile(r"lora_unet_(token_refiner_)?blocks_(\d+)_(attn_qkv_proj|attn_out_proj|mlp_fc1|mlp_fc2)")
KOHYA_TO = {"attn_qkv_proj": "attn.qkv_proj", "attn_out_proj": "attn.out_proj",
            "mlp_fc1": "mlp.fc1", "mlp_fc2": "mlp.fc2"}
PART = re.compile(r"(?P<mod>.+)\.(?P<part>lora_A|lora_B|lora_down|lora_up|alpha|lokr_w1|lokr_w2)(?:\.default)?(?:\.weight)?$")
PEFT = re.compile(r"(?P<tok>token_refiner\.refiner_blocks|transformer_blocks)\.(?P<n>\d+)\.(?P<sub>.+)")
PEFT_SUB = {"attn.to_q": ("attn.qkv_proj", "q"), "attn.to_k": ("attn.qkv_proj", "k"),
            "attn.to_v": ("attn.qkv_proj", "v"), "attn.to_out.0": ("attn.out_proj", ""),
            "ff.net.0.proj": ("mlp.fc1", ""), "ff.net.2": ("mlp.fc2", "")}
QKV_P = {"q": 0, "k": 1, "v": 2}
MODTYPE = re.compile(r"(attn\.qkv_proj|attn\.out_proj|mlp\.fc1|mlp\.fc2)")
HEAD_DIM = 128  # h3_dit.c:18


def qkv_perm(out):
    """indice natif n -> ligne Comfy : n = h*3*HD + p*HD + d  <-  p*(out/3) + h*HD + d"""
    import numpy as np
    inner = out // 3
    if out % 3 or inner % HEAD_DIM:
        die(f"qkv of {out} rows: not 3 x multiple of {HEAD_DIM}")
    n = np.arange(out)
    h, rem = n // (3 * HEAD_DIM), n % (3 * HEAD_DIM)
    p, d = rem // HEAD_DIM, rem % HEAD_DIM
    return p * inner + h * HEAD_DIM + d


def make_src(c, out):
    """native row n -> LoRA delta row (-1: no contribution), according to operation c["op"]"""
    import numpy as np
    n = np.arange(out)
    if c["op"] == "qkv-comfy":
        return qkv_perm(out)
    if c["op"] == "qkv-peft":
        h, rem = n // (3 * HEAD_DIM), n % (3 * HEAD_DIM)
        p, d = rem // HEAD_DIM, rem % HEAD_DIM
        return np.where(p == QKV_P[c["tag"]], h * HEAD_DIM + d, -1)
    if c["op"] == "fc1-swap":
        return (n + out // 2) % out
    raise ValueError(c["op"])


def die(msg, code=2):
    print("REFUS : " + msg, file=sys.stderr)
    sys.exit(code)


def read_header(path):
    with open(path, "rb") as f:
        n = struct.unpack("<Q", f.read(8))[0]
        h = json.loads(f.read(n))
    h.pop("__metadata__", None)
    return 8 + n, h


def read_meta(path):
    with open(path, "rb") as f:
        n = struct.unpack("<Q", f.read(8))[0]
        return json.loads(f.read(n)).get("__metadata__") or {}


def read_scalar(path, data_start, t):
    with open(path, "rb") as f:
        f.seek(data_start + t["data_offsets"][0])
        b = f.read(DT[t["dtype"]])
    if t["dtype"] == "F32":
        return struct.unpack("<f", b)[0]
    if t["dtype"] == "F16":
        return struct.unpack("<e", b)[0]
    return struct.unpack("<f", struct.pack("<I", struct.unpack("<H", b)[0] << 16))[0]


def parse_lora(path):
    """-> (modules, erreurs). modules[tenseur_modele] = dict(kind, parts..., alpha)"""
    ds, h = read_header(path)
    meta = read_meta(path)
    mods, errs = {}, []
    prefixes = set()
    for k, t in h.items():
        prefixes.add("diffusers" if k.startswith(("transformer_blocks.", "token_refiner.refiner_blocks."))
                     else "comfy" if k.startswith(("diffusion_model.", "lora_unet_")) else "natif")
        m = PART.fullmatch(k)
        if not m:
            errs.append(f"{k} (cle non reconnue)")
            continue
        mod, part = m.group("mod"), m.group("part")
        tag = ""
        g2 = PEFT.fullmatch(mod)
        if g2:
            if part not in ("lora_A", "lora_B"):
                errs.append(f"{k} (partie {part} non geree en PEFT)")
                continue
            if g2.group("sub") not in PEFT_SUB:
                errs.append(f"{k} (target module PEFT without native equivalent: {g2.group('sub')})")
                continue
            nat, tag = PEFT_SUB[g2.group("sub")]
            name = ("token_refiner.blocks." if g2.group("tok").startswith("token") else "blocks.") \
                + g2.group("n") + "." + nat
        elif mod.startswith("lora_unet_"):
            g = KOHYA.fullmatch(mod)
            if not g:
                errs.append(f"{k} (nom kohya non reconnu)")
                continue
            name = ("token_refiner." if g.group(1) else "") + f"blocks.{g.group(2)}." + KOHYA_TO[g.group(3)]
        else:
            name = mod[len("diffusion_model."):] if mod.startswith("diffusion_model.") else mod
        part = {"lora_A": "down", "lora_down": "down", "lora_B": "up", "lora_up": "up"}.get(part, part)
        mods.setdefault((name + ".weight", tag), {})[part] = (path, ds, t)
    return mods, errs, prefixes, meta


def lcm(a, b):
    return a * b // math.gcd(a, b)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("modele", help="model directory (contains FL2VA/ or transformer/)")
    ap.add_argument("sortie", help="dossier de sortie (doit etre absent ou vide)")
    ap.add_argument("--lora", action="append", required=True, metavar="FICHIER[@FORCE]",
                    help="LoRA and its force (default 1.0); repeatable")
    ap.add_argument("--transformer", help="transformer subdirectory, relative to the model (e.g. Ref2VA/transformer)")
    ap.add_argument("--essai", action="store_true", help="lists what would be changed, writes nothing")
    ap.add_argument("--qkv", choices=("auto", "comfy", "natif"), default="auto",
                    help="qkv_proj layout in the LoRAs (see header); auto: from the keys")
    a = ap.parse_args()

    loras = []
    for spec in a.lora:
        p, s = spec, 1.0
        if "@" in spec:
            p, _, tail = spec.rpartition("@")
            try:
                s = float(tail)
            except ValueError:
                p, s = spec, 1.0
        if not os.path.isfile(p):
            die(f"LoRA introuvable : {p}")
        loras.append((os.path.abspath(p), s))

    root = os.path.abspath(a.modele)
    if a.transformer:
        rel = a.transformer.strip("/")
    elif os.path.isfile(os.path.join(root, "FL2VA/transformer/config.json")):
        rel = "FL2VA/transformer"
    elif os.path.isfile(os.path.join(root, "transformer/config.json")):
        rel = "transformer"
    else:
        die(f"aucun transformer trouve sous {root} (FL2VA/transformer ou transformer)")
    tdir = os.path.join(root, rel)
    idxs = sorted(x for x in os.listdir(tdir) if x.endswith(".safetensors.index.json"))
    if idxs:
        wm = json.load(open(os.path.join(tdir, idxs[0])))["weight_map"]
        shards = sorted(set(wm.values()))
    else:
        idxs = []
        shards = sorted(x for x in os.listdir(tdir) if x.endswith(".safetensors"))
        wm = {}
    heads = {}
    for s in shards:
        p = os.path.join(tdir, s)
        if not os.path.isfile(p):
            die(f"shard absent : {p}")
        ds, h = read_header(p)
        if ds + max((v["data_offsets"][1] for v in h.values()), default=0) != os.path.getsize(p):
            die(f"shard incomplet (taille != en-tete) : {p}")
        heads[s] = (ds, h)
        if not idxs:
            wm.update({k: s for k in h})
    if "transformer_blocks.0.attn.to_q.weight" in wm and "blocks.0.attn.qkv_proj.weight" not in wm:
        die("this transformer is in diffusers format (transformer_blocks.N.attn.to_q...). h3.c and these LoRAs "
            "use the native format (blocks.N.attn.qkv_proj.weight): use FL2VA/transformer from the HF repo.")
    if "blocks.0.attn.qkv_proj.weight" not in wm:
        die("noms natifs absents (blocks.0.attn.qkv_proj.weight)")

    # --- LoRA analysis
    contribs = {}  # tenseur -> liste de contributions
    bad = []
    info = []
    for li, (lp, force) in enumerate(loras):
        mods, errs, prefixes, meta = parse_lora(lp)
        bad += [f"{os.path.basename(lp)} : {e}" for e in errs]
        if prefixes == {"diffusers"}:
            layout = "diffusers"
        elif "diffusers" in prefixes:
            bad.append(f"{os.path.basename(lp)} : cles PEFT diffusers melangees a d'autres formats")
            layout = "diffusers"
        elif a.qkv != "auto":
            layout = a.qkv
        elif len(prefixes) == 1:
            layout = prefixes.pop()
        else:
            bad.append(f"{os.path.basename(lp)} : mixed Comfy and native keys, specify --qkv")
            layout = "natif"
        kinds, ranks, scales = set(), set(), []
        asrc = set()
        for (tname, qtag), d in mods.items():
            tag = f"{os.path.basename(lp)} : {tname}" + (f" [{qtag}]" if qtag else "")
            if tname not in wm:
                bad.append(f"{tag} (no corresponding tensor in the model)")
                continue
            ds, h = heads[wm[tname]]
            W = h[tname]
            if len(W["shape"]) != 2:
                bad.append(f"{tag} (target tensor not 2D)")
                continue
            if W["dtype"] not in DT:
                bad.append(f"{tag} (dtype cible {W['dtype']} non gere)")
                continue
            out, inn = W["shape"]
            keys = set(d)
            if keys - {"alpha"} == {"up", "down"}:
                up, down = d["up"][2], d["down"][2]
                exp_rows = out // 3 if qtag else out
                if len(up["shape"]) != 2 or len(down["shape"]) != 2 or up["shape"][1] != down["shape"][0] \
                        or up["shape"][0] != exp_rows or down["shape"][1] != inn:
                    bad.append(f"{tag} (formes B{up['shape']} A{down['shape']} vs W{W['shape']})")
                    continue
                r = down["shape"][0]
                alpha = r
                asrc.add("rang")
                if layout == "diffusers":
                    try:
                        alpha = float(meta["alpha"])
                        if not 0 < alpha < float("inf"):
                            raise ValueError
                    except (KeyError, ValueError, TypeError):
                        bad.append(f"{tag} (format PEFT : __metadata__[alpha] absent ou invalide : {meta.get('alpha')!r})")
                        continue
                    asrc.clear(); asrc.add("__metadata__")
                elif "alpha" in d:
                    if d["alpha"][2]["shape"] != []:
                        bad.append(f"{tag} (alpha not scalar)")
                        continue
                    alpha = read_scalar(d["alpha"][0], d["alpha"][1], d["alpha"][2])
                    asrc.clear(); asrc.add("tenseur alpha")
                sc = force * alpha / r
                c = dict(lora=li, kind="lora", up=d["up"], down=d["down"], coef=sc, mult=1, tag=qtag)
                kinds.add("lora"); ranks.add(r)
            elif keys - {"alpha"} == {"lokr_w1", "lokr_w2"}:
                w1, w2 = d["lokr_w1"][2], d["lokr_w2"][2]
                if len(w1["shape"]) != 2 or len(w2["shape"]) != 2 or \
                        w1["shape"][0] * w2["shape"][0] != out or w1["shape"][1] * w2["shape"][1] != inn:
                    bad.append(f"{tag} (formes kron({w1['shape']},{w2['shape']}) vs W{W['shape']})")
                    continue
                sc = force  # LyCORIS lokr.py l.210-212: w1 and w2 full -> alpha ignored, scale 1
                c = dict(lora=li, kind="lokr", w1=d["lokr_w1"], w2=d["lokr_w2"], coef=sc, mult=w2["shape"][0], tag="")
                kinds.add("lokr"); ranks.add(0)
            else:
                bad.append(f"{tag} (jeu de cles incomplet ou inconnu : {sorted(keys)})")
                continue
            c["tname"] = tname
            c["op"] = None
            if layout == "diffusers" and qtag:
                c["op"] = "qkv-peft"
            elif layout == "diffusers" and tname.endswith("mlp.fc1.weight"):
                c["op"] = "fc1-swap"
            elif layout == "comfy" and tname.endswith("attn.qkv_proj.weight"):
                c["op"] = "qkv-comfy"
            if c["op"] and c["kind"] == "lokr":
                bad.append(f"{tag} (LoKr with permutation {c['op']}: not written)")
                continue
            contribs.setdefault(tname, []).append(c)
            scales.append(sc / force if force else 0)
        if layout == "diffusers":
            for tn, cs in contribs.items():
                tg = sorted(c["tag"] for c in cs if c["lora"] == li and c["op"] == "qkv-peft")
                if tg and tg != ["k", "q", "v"]:
                    bad.append(f"{os.path.basename(lp)} : {tn} : q/k/v incomplets ({tg})")
        opn = {}
        for cs in contribs.values():
            for c in cs:
                if c["lora"] == li and c["op"]:
                    opn[c["op"]] = opn.get(c["op"], 0) + 1
        info.append((os.path.basename(lp), force, len(mods), sorted(kinds), sorted(ranks),
                     (min(scales), max(scales)) if scales else None, layout, opn, sorted(asrc)))
    if bad:
        print(f"{len(bad)} probleme(s) :", file=sys.stderr)
        for b in bad[:60]:
            print("  - " + b, file=sys.stderr)
        if len(bad) > 60:
            print(f"  ... {len(bad) - 60} autres", file=sys.stderr)
        die("keys without correspondence or incompatible shapes, nothing is written.")

    touched = sorted({wm[t] for t in contribs})
    print(f"Transformer : {tdir}  ({len(shards)} shards, {len(wm)} tenseurs)")
    for name, force, nm, kinds, ranks, sc, layout, opn, asrc in info:
        print(f"LoRA {name} force={force} modules={nm} type={'/'.join(kinds)} rang={ranks} echelle(alpha/rang)={sc} "
              f"format={layout} alpha read from: {'/'.join(asrc)}")
        print(f"  permutations/poses : " + (", ".join(f"{k} x{v}" for k, v in sorted(opn.items())) or "aucune"))
    tb = sum(os.path.getsize(os.path.join(tdir, s)) for s in touched)
    print(f"Tenseurs modifies : {len(contribs)} ; shards reecrits : {len(touched)}/{len(shards)} ({tb / 2**30:.1f} Gio) ; "
          f"shards en lien : {len(shards) - len(touched)}")
    for s in touched:
        print(f"  {s} : {sum(1 for t in contribs if wm[t] == s)} tenseurs")
    if a.essai:
        print("--essai : rien n'a ete ecrit.")
        return

    try:
        import numpy as np
    except ImportError:
        die("numpy is required for the real fusion (python3 -m venv ... && pip install numpy)")
    out_root = os.path.abspath(a.sortie)
    if os.path.exists(out_root) and os.listdir(out_root):
        die(f"sortie non vide : {out_root}")
    os.makedirs(out_root, exist_ok=True)
    free = shutil.disk_usage(out_root).free
    if free < tb + 2 * 2**30:
        shutil.rmtree(out_root, ignore_errors=True)
        die(f"place insuffisante : {free / 2**30:.0f} Gio libres, {tb / 2**30:.0f} Gio + marge requis")

    # --- output tree: real directories along the transformer path, links elsewhere
    parts = rel.split("/")
    cur_src, cur_dst = root, out_root
    for i, part in enumerate(parts):
        for e in sorted(os.listdir(cur_src)):
            if e != part:
                os.symlink(os.path.join(cur_src, e), os.path.join(cur_dst, e))
        cur_src, cur_dst = os.path.join(cur_src, part), os.path.join(cur_dst, part)
        os.makedirs(cur_dst)
    for e in sorted(os.listdir(tdir)):
        src, dst = os.path.join(tdir, e), os.path.join(cur_dst, e)
        if e.endswith(".safetensors.index.json"):
            shutil.copyfile(src, dst)
        elif e not in touched:
            os.symlink(src, dst)

    def to_f32(buf, dt):
        if dt == "F32":
            return np.frombuffer(buf, dtype="<f4").astype(np.float32)
        if dt == "F16":
            return np.frombuffer(buf, dtype="<f2").astype(np.float32)
        return (np.frombuffer(buf, dtype="<u2").astype(np.uint32) << 16).view(np.float32)

    def from_f32(x, dt):
        if dt == "F32":
            return x.astype("<f4").tobytes()
        if dt == "F16":
            return x.astype("<f2").tobytes()
        u = np.ascontiguousarray(x).view(np.uint32)
        return ((u + (((u >> 16) & 1) + 0x7FFF)) >> 16).astype("<u2").tobytes()

    def load(ref):
        path, ds, t = ref
        b, e = t["data_offsets"]
        with open(path, "rb") as f:
            f.seek(ds + b)
            buf = f.read(e - b)
        return to_f32(buf, t["dtype"]).reshape(t["shape"])

    stats = {li: {} for li in range(len(loras))}
    changed = {li: [0, 0] for li in range(len(loras))}
    t0 = time.time()
    for s in touched:
        ds, h = heads[s]
        src, dst = os.path.join(tdir, s), os.path.join(cur_dst, s)
        if sys.platform == "darwin" and subprocess.call(["cp", "-c", src, dst], stderr=subprocess.DEVNULL) == 0:
            pass
        else:
            shutil.copyfile(src, dst)
        with open(src, "rb") as fi, open(dst, "r+b") as fo:
            for tname in sorted(t for t in contribs if wm[t] == s):
                T = h[tname]
                dt = T["dtype"]
                out, inn = T["shape"]
                isz = DT[dt]
                cs = contribs[tname]
                L = 1
                for c in cs:
                    L = lcm(L, c["mult"])
                step = min(out, L * max(1, 2048 // L))
                ops = []
                for c in cs:
                    if c["kind"] == "lora":
                        c["src"] = make_src(c, out) if c["op"] else None  # native line -> delta line
                        ops.append((c, load(c["up"]), load(c["down"])))
                    else:
                        ops.append((c, load(c["w1"]), load(c["w2"])))
                ss = {c["lora"]: 0.0 for c in cs}
                wss = 0.0
                for r0 in range(0, out, step):
                    r1 = min(out, r0 + step)
                    fi.seek(ds + T["data_offsets"][0] + r0 * inn * isz)
                    raw = fi.read((r1 - r0) * inn * isz)
                    w = to_f32(raw, dt).reshape(r1 - r0, inn)
                    wss += float(np.vdot(w, w))
                    for c, x, y in ops:
                        if c["kind"] == "lora":
                            if c["src"] is None:
                                d = (x[r0:r1] * np.float32(c["coef"])) @ y
                            else:
                                sr = c["src"][r0:r1]
                                mk = sr >= 0
                                d = np.zeros((r1 - r0, inn), np.float32)
                                if mk.any():
                                    d[mk] = (x[sr[mk]] * np.float32(c["coef"])) @ y
                        else:
                            m = c["mult"]
                            d = np.kron(x[r0 // m: -(-r1 // m)], y) * np.float32(c["coef"])
                        ss[c["lora"]] += float(np.vdot(d, d))
                        w += d
                    nb = from_f32(w, dt)
                    if dt == "F32":
                        nchg = int(np.count_nonzero(np.frombuffer(nb, "<u4") != np.frombuffer(raw, "<u4")))
                    else:
                        nchg = int(np.count_nonzero(np.frombuffer(nb, "<u2") != np.frombuffer(raw, "<u2")))
                    for c in cs:
                        changed[c["lora"]][0] += nchg
                        changed[c["lora"]][1] += w.size
                    fo.seek(ds + T["data_offsets"][0] + r0 * inn * isz)
                    fo.write(nb)
                for c in cs:
                    if not math.isfinite(ss[c["lora"]]):
                        die(f"delta not finished in {tname}, incomplete output: {out_root}", 3)
                    mt = (MODTYPE.search(tname) or re.search(r"^(.*)\.weight$", tname)).group(1)
                    rel_n = math.sqrt(ss[c["lora"]] / wss) if wss > 0 else float("nan")
                    stats[c["lora"]].setdefault(mt, []).append(rel_n)
        print(f"  {s} fait ({time.time() - t0:.0f} s)", flush=True)

    print("Journal :")
    for li, (lp, force) in enumerate(loras):
        n = sum(len(v) for v in stats[li].values())
        print(f"LoRA {os.path.basename(lp)} force={force} : {n} tenseurs modifies ; "
              f"valeurs bf16 changees {100 * changed[li][0] / max(1, changed[li][1]):.1f} %")
        for mt, v in sorted(stats[li].items()):
            print(f"    {mt:14s} n={len(v):3d} average relative norm of the delta = {sum(v) / len(v):.4f}")
    json.dump({"modele": root, "transformer": rel, "qkv": [i[6] for i in info],
               "loras": [{"fichier": p, "force": f} for p, f in loras]},
              open(os.path.join(out_root, "fusion_lora_h3.json"), "w"), indent=1)
    print(f"Termine en {time.time() - t0:.0f} s : {out_root}")


if __name__ == "__main__":
    main()
