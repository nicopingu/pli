def cles_json(prod: list[Path]) -> list[dict]:
    lignes_gen = []
    for p in sorted((SRC / "pli" / "gen").glob("*.py")):
        for i, t in enumerate(p.read_text().splitlines(), 1):
            lignes_gen.append((f"pli/gen/{p.name}:{i}", t))
    vues: dict[tuple, dict] = {}

    def ajoute(fichier_logique: str, donnees, origine: str):
        for chemin, valeur in _chemins_json(donnees):
            cle = (fichier_logique, chemin)
            e = vues.setdefault(cle, {"fichier": fichier_logique, "chemin": ".".join(chemin),
                                      "famille": _famille_json(fichier_logique, chemin), "type": _type_json(valeur),
                                      "exemples": [], "production": False, "lu": []})
            if origine == "prod":
                e["production"] = True
            elif origine not in e["exemples"]:
                e["exemples"].append(origine)

    for rel, logique in EXEMPLES_JSON.items():
        p = RACINE / rel
        if p.is_file():
            try:
                ajoute(logique, json.loads(p.read_text()), rel)
            except ValueError:
                pass
    for p in prod:
        if p.is_file():
            try:
                ajoute(p.name, json.loads(p.read_text()), "prod")
            except ValueError:
                pass
    for e in vues.values():
        dernier = e["chemin"].split(".")[-1]
        e["lu"] = [lieu for lieu, t in lignes_gen if f'"{dernier}"' in t][:3]
    return sorted(vues.values(), key=lambda e: (FAMILLES.index(e["famille"]), e["fichier"], e["chemin"]))


def _type_json(v) -> str:
    return ("drapeau" if isinstance(v, bool) else "entier" if isinstance(v, int) else "reel" if isinstance(v, float)
            else "liste" if isinstance(v, list) else "objet" if isinstance(v, dict) else "texte")


