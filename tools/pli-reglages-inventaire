def _nom_env(s: object) -> bool:
    return isinstance(s, str) and (re.fullmatch(r"PLI_[A-Z0-9_]+", s) is not None or s in MLX_REGLAGES)


def _texte_court(node: ast.AST, n: int = 60) -> str:
    try:
        t = ast.unparse(node)
    except Exception:  # noqa: BLE001
        t = "?"
    return t if len(t) <= n else t[: n - 1] + "…"


def _constantes(node: ast.AST) -> list:
    if isinstance(node, ast.Constant):
        return [node.value]
    if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
        return [e.value for e in node.elts if isinstance(e, ast.Constant)]
    return []


def _type_lu(node: ast.AST, parents: dict) -> tuple[str, list]:
    """Type inferred from what the code does with the read value: int(), float(), comparison to "1"..."""

    cur = node
    for _ in range(6):
        p = parents.get(cur)
        if p is None:
            break
        if (isinstance(p, (ast.If, ast.IfExp, ast.While)) and p.test is cur) or isinstance(p, ast.UnaryOp):
            return "present", []                       # only "set or not": says nothing about the type
        if isinstance(p, ast.Call) and isinstance(p.func, ast.Attribute) and p.func.value is cur \
                and p.func.attr in ("strip", "lower", "upper"):
            cur = p
            continue
        if isinstance(p, ast.BoolOp):
            cur = p
            continue
        if isinstance(p, ast.Call) and isinstance(p.func, ast.Name) and cur in p.args:
            if p.func.id == "int":
                return "entier", []
            if p.func.id == "float":
                return "reel", []
            if p.func.id == "bool":
                return "drapeau", []
            if p.func.id == "Path":
                return "chemin", []
        if isinstance(p, ast.Call) and isinstance(p.func, ast.Attribute) and p.func.attr == "value" and cur in p.args:
            cur = p                                    # env_names.value(nom, texte)
            continue
        if isinstance(p, ast.Compare):
            consts = []
            for c in [p.left, *p.comparators]:
                if c is not cur:
                    consts += [v for v in _constantes(c) if isinstance(v, str)]
            if consts and set(consts) == {""}:
                return "present", []                   # compared to "": set or not
            if consts and set(c.lower() for c in consts) <= VALEURS_DRAPEAU:
                return "drapeau", sorted(set(consts))   # the values that the code compares
            if consts:
                return "choix", sorted(set(consts))
        break
    return "texte", []


def lectures_env(src: Path = SRC) -> tuple[dict, dict, dict]:
    """{name: [read...]}, {name: [mention...]}, {name: [write...]} for all src/."""

    lus: dict[str, list] = {}
    mentions: dict[str, list] = {}
    ecrits: dict[str, list] = {}
    for chemin in sorted(src.rglob("*.py")):
        rel = chemin.relative_to(src).as_posix()
        if rel.endswith("additions/env_names.py") or rel.startswith("pli/config/"):
            continue
        try:
            arbre = ast.parse(chemin.read_text(), filename=str(chemin))
        except SyntaxError:
            continue
        parents = {}
        for n in ast.walk(arbre):
            for e in ast.iter_child_nodes(n):
                parents[e] = n
        vus = set()
        # module constants that name a variable: LIMIT_ENV = "PLI_MEMORY_LIMIT_GB"
        constantes = {}
        for n in arbre.body:
            if isinstance(n, ast.Assign) and isinstance(n.value, ast.Constant) and _nom_env(n.value.value):
                for c in n.targets:
                    if isinstance(c, ast.Name):
                        constantes[c.id] = n.value.value
                        vus.add(id(n.value))

        def nom_de(x):
            if isinstance(x, ast.Constant) and _nom_env(x.value):
                return x.value
            if isinstance(x, ast.Name) and x.id in constantes:
                return constantes[x.id]
            return None

        for n in ast.walk(arbre):
            lieu = f"{rel}:{getattr(n, 'lineno', 0)}"
            if isinstance(n, ast.Call) and n.args and nom_de(n.args[0]):
                nom = nom_de(n.args[0])
                f = n.func
                fnom = f.attr if isinstance(f, ast.Attribute) else f.id if isinstance(f, ast.Name) else ""
                source = _texte_court(f.value) if isinstance(f, ast.Attribute) else ""
                environ = "environ" in source or source in ("env", "environ", "os")
                if (fnom in ("get", "pop") and environ) or fnom in FONCTIONS_LECTURE \
                        or (fnom == "pop" and source == "env_names"):
                    defaut = None
                    if len(n.args) > 1:
                        defaut = (n.args[1].value if isinstance(n.args[1], ast.Constant)
                                  else f"(calculated: {_texte_court(n.args[1], 40)})")
                    typ, choix = (TYPE_DE_FONCTION[fnom], []) if fnom in TYPE_DE_FONCTION else _type_lu(n, parents)
                    lus.setdefault(nom, []).append({"lieu": lieu, "defaut": defaut, "type": typ, "choix": choix})
                    vus.add(id(n.args[0]))
                    continue
                if fnom == "setdefault" and environ:
                    ecrits.setdefault(nom, []).append(lieu)
                    vus.add(id(n.args[0]))
                    continue
            if isinstance(n, ast.Subscript) and nom_de(n.slice) and "environ" in _texte_court(n.value):
                nom = nom_de(n.slice)
                if isinstance(n.ctx, ast.Load):
                    typ, choix = _type_lu(n, parents)
                    lus.setdefault(nom, []).append({"lieu": lieu, "defaut": None, "type": typ, "choix": choix})
                else:
                    ecrits.setdefault(nom, []).append(lieu)
                vus.add(id(n.slice))
                continue
            if isinstance(n, ast.Compare) and isinstance(n.left, ast.Constant) and _nom_env(n.left.value) \
                    and any("environ" in _texte_court(c) for c in n.comparators):
                lus.setdefault(n.left.value, []).append({"lieu": lieu, "defaut": None, "type": "present", "choix": []})
                vus.add(id(n.left))
        for n in ast.walk(arbre):
            if isinstance(n, ast.Constant) and _nom_env(n.value) and id(n) not in vus:
                mentions.setdefault(n.value, []).append(f"{rel}:{n.lineno}")
    return lus, mentions, ecrits


def _fusion(lectures: list) -> tuple[str, list, object, list]:
    """Type, choice, default, and inconsistencies between read locations."""

    types = [l["type"] for l in lectures if l["type"] != "present"]
    alertes = []
    if not types:
        typ = "drapeau" if lectures else "texte"
    elif len(set(types)) == 1:
        typ = types[0]
    elif set(types) <= {"drapeau", "choix"}:
        typ = "choix"
    elif set(types) <= {"drapeau", "entier"}:
        typ = "entier"
        alertes.append("read as a flag (« 1 ») in one place and as a number in another: the value 1 has a meaning of its own")
    elif set(types) <= {"drapeau", "entier", "reel"}:
        typ = "reel"
        if "drapeau" in types:
            alertes.append("read as a flag (« 1 ») in one place and as a number in another: the value 1 has a meaning of its own")
    else:
        typ = "texte"
        alertes.append("different types depending on the location: " + ", ".join(sorted(set(types))))
    choix = sorted({c for l in lectures for c in l["choix"]})
    if typ not in ("choix", "drapeau"):
        choix = []
    defauts = [l["defaut"] for l in lectures if l["defaut"] is not None]
    distincts = sorted({str(d) for d in defauts})
    if len(distincts) > 1:
        alertes.append("different defaults depending on the location: " + ", ".join(repr(d) for d in distincts))
    defaut = defauts[0] if defauts else None
    return typ, choix, defaut, alertes


def _famille_var(nom: str) -> tuple[str, str]:
    if nom in CLES_FORCEES:
        cle = CLES_FORCEES[nom]
        return cle.rsplit(".", 1)[0], cle
    for motif, famille, prefixes in REGLES_VAR:
        if re.search(motif, nom):
            court = nom.lower().removeprefix("pli_")
            for p in prefixes:
                if court.startswith(p) and len(court) > len(p):
                    court = court[len(p):]
                    break
            return famille, f"{famille}.{court}"
    raise AssertionError(nom)


def alias_genere(cle: str) -> str:
    """The variable derived from the key: PLI_FAMILLE_REGLAGE (dots and hyphens to _)."""

    return "PLI_" + re.sub(r"[.\-]", "_", cle).upper()


