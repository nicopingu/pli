# JSON keys for generation
CARTES = {"familles", "modeles", "lora", "voix"}       # objects whose keys are free names


def _chemins_json(obj, prefixe=()):
    if isinstance(obj, dict):
        for k, v in obj.items():
            if prefixe and prefixe[-1] in CARTES:
                yield from _chemins_json(v, prefixe + ("<nom>",))
                continue
            if k.startswith("_"):
                continue
            yield prefixe + (k,), v
            yield from _chemins_json(v, prefixe + (k,))
    elif isinstance(obj, list) and obj and isinstance(obj[0], dict):
        for e in obj:
            yield from _chemins_json(e, prefixe + ("[]",))


def _famille_json(fichier: str, chemin: tuple) -> str:
    if "lora" in chemin:
        return "gen.lora"
    if "voix" in fichier or (chemin[:3] == ("familles", "<nom>", "voix")):
        return "gen.voix"
    if "image" in fichier:
        return "gen.image"
    if "video" in fichier:
        return "gen.video"
    return "gen"


EXEMPLES_JSON = {
    "docs/gen/pli-gen-config.exemple.json": "pli-gen.json",
    "docs/pli-gen.exemple.json": "pli-gen.json",
    "src/pli/gen/exemple_config.json": "pli-gen.json",
    "docs/pli-gen-voix.exemple.json": "voix.json",
