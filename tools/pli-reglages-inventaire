def options_serve() -> list[dict]:
    sys.path.insert(0, str(SRC))
    from pli import cli_args

    parser = cli_args.build_parser({k: (lambda a: 0) for k in ("serve", "pull", "models", "update", "info", "plan")})
    sous = next(a for a in parser._actions if isinstance(a, argparse._SubParsersAction))
    serve = sous.choices["serve"]
    fichier = (SRC / "pli" / "cli_args.py").read_text().splitlines()
    sortie = []
    for a in serve._actions:
        if not a.option_strings or a.dest in ("help", "config"):   # --config names the file itself
            continue
        ligne = next((i + 1 for i, t in enumerate(fichier) if f'"{a.option_strings[0]}"' in t), 0)
        nom_action = type(a).__name__
        if nom_action in ("_StoreTrueAction",):
            typ = "drapeau"
        elif nom_action == "BooleanOptionalAction":
            typ = "drapeau"
        elif nom_action == "_AppendAction":
            typ = "liste"
        elif a.choices:
            typ = "choix"
        elif a.type is int:
            typ = "entier"
        elif a.type is float:
            typ = "reel"
        else:
            typ = "texte"
        defaut = a.default
        if isinstance(defaut, str) and defaut.startswith(str(Path.home())):
            defaut = "~" + defaut[len(str(Path.home())):]
        sortie.append({
            "dest": a.dest, "options": list(a.option_strings), "type": typ,
            "choix": [str(c) for c in a.choices] if a.choices else [],
            "defaut": defaut, "aide": " ".join((a.help or "").split()).replace("%(default)s", str(defaut)),
            "action": nom_action, "lieu": f"pli/cli_args.py:{ligne}",
        })
    return sortie


def aides_switches() -> dict[str, tuple[str, str]]:
    """{variable: (help, status)} read from the tables in docs/switches.md."""

    chemin = RACINE / "docs" / "switches.md"
    if not chemin.is_file():
        return {}
    aides = {}
    statut = ""
    entetes: list[str] = []
    for ligne in chemin.read_text().splitlines():
        if ligne.startswith("## "):
            titre = ligne[3:].lower()
            statut = ("stable" if titre.startswith("1.") else "machine" if titre.startswith("2.")
                      else "experimental" if titre.startswith("3.") else "reglage-fin" if titre.startswith("4.")
                      else "autre")
            entetes = []
            continue
        if not ligne.startswith("|"):
            continue
        cases = [c.strip() for c in ligne.strip().strip("|").split("|")]
        if cases and cases[0] == "Variable":
            entetes = cases
            continue
        if not entetes or set(cases[0]) <= set("- "):
            continue
        m = re.fullmatch(r"`([A-Z0-9_]+)`", cases[0])
        if not m:
            continue
        col = next((i for i, e in enumerate(entetes) if e.startswith("What")), len(cases) - 2)
        if col < len(cases):
            aides[m.group(1)] = (cases[col].replace("`", ""), statut)
    return aides


