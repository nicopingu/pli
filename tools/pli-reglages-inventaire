def production_reference() -> tuple[set[str], set[str]]:
    """(variables, options) set by the reference production (tests/fixtures/reglages)."""

    import shlex

    nouveau = dict(anciens_noms())
    variables: set[str] = set()
    options: set[str] = set()
    for f in sorted(PRODUCTION_REFERENCE.glob("*.env")):
        variables |= {nouveau.get(k, k) for k in lire_env(f)}
    for f in sorted(PRODUCTION_REFERENCE.glob("options-*.txt")):
        options |= {j.split("=", 1)[0] for j in shlex.split(f.read_text()) if j.startswith("--")}
    return variables, options


def profil_m1_ultra() -> set[str]:
    nouveau = dict(anciens_noms())
    return {nouveau.get(k, k) for f in (SRC / "pli" / "additions" / "profiles").rglob("*.env") for k in lire_env(f)}


def statut_de(r: dict, prod_vars: set[str], prod_opts: set[str], profil: set[str]) -> tuple[str, str, str]:
    """(status, reason, doubt) of a setting."""

    en_prod = (r["source"] == "variable" and r["variable"] in prod_vars) or \
              (r["source"] == "option" and bool(prod_opts & set(r["options"])))
    doute = ""
    doc = r.get("doc_statut", "")
    if r["cle"] in STATUTS_FORCES:
        statut, raison = STATUTS_FORCES[r["cle"]]
        if en_prod and statut != "recommande":
            doute = f"in production but {statut} ({raison})"
        return statut, raison, doute
    if en_prod or r.get("variable") in profil:
        raison = "in production" if en_prod else "set by the m1-ultra profile (measured)"
        if doc in ("experimental", "reglage-fin") or r["aide"].lower().startswith("experimental"):
            doute = f"in production, but docs/switches.md classes it « {doc or 'experimental'} »"
        elif r["famille"] == "journal" or r["cle"] in ("gen.garde_journal", "brouillons.falcon_tokens",
                                                       "brouillons.falcon_tokens_days"):
            doute = "in production, but only used for logging or capturing (no effect on computation)"
        elif "fallback" in r["aide"].lower():
            doute = "in production, but only as a fallback (another setting is used first)"
        return "recommande", raison, doute
    if r["source"] == "derive":
        return "recommande", "same effect as a measured value of its original setting", ""
    if doc == "stable":
        return "recommande", "docs/switches.md : stable", ""
    if doc == "machine":
        if r["aide"].lower().startswith("experimental"):
            return "experimental", "docs/switches.md : experimental", ""
        return "recommande", "docs/switches.md : stable machine setting", ""
    if doc == "autre":
        return "recommande", "docs/switches.md", ""
    if doc in ("experimental", "reglage-fin"):
        return "experimental", "docs/switches.md : " + ("experimental" if doc == "experimental"
                                                        else "fine-tuning setting, change only to measure"), ""
    if r["source"] == "option":
        if r["famille"] == "expert":
            return "experimental", "fine-tuning option", ""
        return "recommande", "documented pli serve option", ""
    return "experimental", "undocumented (inherited from TensorFold or research setting)", ""


def construire_table() -> dict:
    lus, mentions, ecrits = lectures_env()
    lus_ailleurs: dict[str, list] = {}
    for dossier in (RACINE / "tests", RACINE / "tools"):
        if dossier.is_dir():
            autres, _, _ = lectures_env(dossier)
            for k, v in autres.items():
                lus_ailleurs.setdefault(k, []).extend(v)
    renommes = anciens_noms()
    nouveau = dict(renommes)
    anciens_de: dict[str, list[str]] = {}
    for vieux, neuf in renommes:
        anciens_de.setdefault(neuf, []).append(vieux)
    aides = aides_switches()

    noms = set(lus) | set(MLX_REGLAGES)
    noms |= {n for n in set(mentions) | set(ecrits) if n not in nouveau}      # mentioned without direct read
    noms |= {neuf for _, neuf in renommes if neuf.startswith(("PLI_", "MLX_"))}
    reglages = []
    cles_vues: dict[str, str] = {}
    for opt in options_serve():
        cle = f"{FAMILLE_OPTION[opt['dest']]}.{opt['dest']}"
        cles_vues[cle] = opt["options"][0]
        reglages.append({
            "cle": cle, "famille": FAMILLE_OPTION[opt["dest"]], "source": "option",
            "options": opt["options"], "dest": opt["dest"], "action": opt["action"],
            "variable": alias_genere(cle), "anciens": [], "type": opt["type"], "choix": opt["choix"],
            "defaut": opt["defaut"], "aide": opt["aide"], "doc_statut": "", "lu": [opt["lieu"]], "alertes": [],
            "note": "",
        })
    for nom in sorted(noms):
        if nom in nouveau:              # an old name read under itself: reported below
            continue
        famille, cle = _famille_var(nom)
        if cle in cles_vues:
            raise SystemExit(f"key collision {cle} : {nom} and {cles_vues[cle]} (add to CLES_FORCEES)")
        cles_vues[cle] = nom
        sites = lus.get(nom, [])
        typ, choix, defaut, alertes = _fusion(sites)
        if not sites and nom in MLX_REGLAGES:
            alertes.append("never read directly in src/ (read by MLX)")
        elif not sites and nom in lus_ailleurs:
            alertes.append("lu seulement hors de src/ : " + ", ".join(s["lieu"] for s in lus_ailleurs[nom][:2]))
        elif not sites:
            alertes.append("never read directly in src/ (" + (
                "read by MLX" if nom in MLX_REGLAGES else
                "mentioned : " + ", ".join(mentions.get(nom, [])[:2]) if nom in mentions else
                "written only" if nom in ecrits else "absent from code") + ")")
        vieux_lus = [v for v in anciens_de.get(nom, []) if v in lus]
        if vieux_lus:
            alertes.append("ancien nom encore lu directement : " + ", ".join(vieux_lus))
        aide, statut = aides.get(nom, ("", ""))
        if nom in NOTES:
            alertes = [a for a in alertes if not a.startswith("read as a flag")]
        alias = alias_genere(cle)
        reglages.append({
            "cle": cle, "famille": famille, "source": "variable", "options": [f"--{cle}"],
            "variable": nom, "alias": alias if alias != nom else "", "anciens": anciens_de.get(nom, []),
            "type": typ if nom not in MLX_REGLAGES else "entier", "choix": choix,
            "defaut": defaut, "aide": aide, "doc_statut": statut,
            "lu": [s["lieu"] for s in sites] or mentions.get(nom, [])[:3] or
                  [s["lieu"] for s in lus_ailleurs.get(nom, [])][:3],
            "ecrit": ecrits.get(nom, [])[:3], "alertes": alertes, "note": NOTES.get(nom, ""),
        })
    for d in DERIVES:
        if d["cle"] in cles_vues or d["variable"] in noms:
            raise SystemExit(f"derived setting collision : {d['cle']}")
        cles_vues[d["cle"]] = d["variable"]
        reglages.append({**d, "source": "derive", "options": [f"--{d['cle']}"], "alias": "", "anciens": [],
                         "choix": [], "doc_statut": "", "lu": ["pli/config/reglages.py (traduit vers " +
                                                               ", ".join(d["pose"]) + ")"], "alertes": [], "note": ""})
    # generated aliases: none must fall on another variable or an old name of another
    connus = {r["variable"]: r["cle"] for r in reglages if r["source"] == "variable"}
    for r in reglages:
        a = r.get("alias") or (r["variable"] if r["source"] == "option" else "")
        if not a:
            continue
        cible = connus.get(a) or (connus.get(nouveau[a]) if a in nouveau else None)
        if cible is not None and cible != r["cle"]:
            r["alertes"].append(f"variable derived from key ({a}) already taken by {cible} : not accepted")
            if r["source"] == "variable":
                r["alias"] = ""
            else:
                r["variable"] = ""
        elif a in nouveau and cible == r["cle"]:
            r["alias"] = ""             # the alias derived from the key is already an old name of the same variable
    prod_vars, prod_opts = production_reference()
    profil = profil_m1_ultra()
    for r in reglages:
        r["statut"], r["statut_raison"], r["doute"] = statut_de(r, prod_vars, prod_opts, profil)
    reglages.sort(key=lambda r: (FAMILLES.index(r["famille"]), r["cle"]))
    return {"version": 1, "familles": list(FAMILLES), "reglages": reglages,
            "anciens_options": {}, "json": cles_json([])}


