def lire_env(chemin: Path) -> dict[str, str]:
    valeurs = {}
    for ligne in chemin.read_text().splitlines():
        ligne = ligne.strip()
        if ligne and not ligne.startswith("#") and "=" in ligne:
            k, v = ligne.split("=", 1)
            valeurs[k.strip()] = v.strip().strip('"')
    return valeurs


def options_prod(yaml: Path) -> dict[str, dict[str, str]]:
    """{service name: {option: value}} of the « pli.sh NAME » blocks in config.yaml (simple read, no PyYAML)."""

    if not yaml.is_file():
        return {}
    lignes = yaml.read_text().splitlines()
    sortie = {}
    for i, ligne in enumerate(lignes):
        m = re.fullmatch(r"\s*\$\{proto\}/pli\.sh (\S+) \$\{PORT\}\s*", ligne)
        if not m:
            continue
        retrait = ligne[: len(ligne) - len(ligne.lstrip())]
        pris = []
        for l in lignes[i + 1:]:                    # the « cmd: | » block: lines at the same indentation
            if not l.startswith(retrait) or not l.strip():
                break
            pris.append(l.strip())
        jetons = " ".join(pris).split()
        opts: dict[str, str] = {}
        i = 0
        while i < len(jetons):
            j = jetons[i]
            if j.startswith("--"):
                if i + 1 < len(jetons) and not jetons[i + 1].startswith("--"):
                    opts[j] = (opts[j] + " " if j in opts else "") + jetons[i + 1]
                    i += 2
                    continue
                opts[j] = "oui"
            i += 1
        sortie[m.group(1)] = opts
    return sortie


def _valeur_publique(nom: str, v: str) -> str:
    if "/" in v or nom.endswith(("ALLOWED_HOSTS", "API_KEY", "HOTES_ADMIS")) or "KEY" in nom:
        return "(machine-specific)"
    return f"`{v}`"


def ecrire_doc(table: dict, prod_env: list[Path], prod_yaml: Path, prod_json: list[Path]) -> str:
    nouveau = {v: n for n, v in [(r["variable"], a) for r in table["reglages"] for a in r.get("anciens", [])]}
    prod_vars: dict[str, list[str]] = {}
    noms_prod: dict[str, list[str]] = {}
    for p in prod_env:
        if p.is_file():
            court = p.stem.removeprefix("pli-") if p.stem != "pli" else "commun"
            for k, v in lire_env(p).items():
                neuf = nouveau.get(k, k)
                prod_vars.setdefault(neuf, []).append(f"{court} {_valeur_publique(neuf, v)}")
                if k != neuf:
                    noms_prod.setdefault(neuf, []).append(k)
    prod_opts = options_prod(prod_yaml)
    profil = {}
    dossier = SRC / "pli" / "additions" / "profiles"
    for f in sorted(dossier.rglob("*.env")):
        for k, v in lire_env(f).items():
            profil.setdefault(nouveau.get(k, k), []).append(f"{f.parent.name}/{f.stem} `{v}`")

    L = [DEBUT, ""]
    regs = table["reglages"]
    par_famille = {f: [r for r in regs if r["famille"] == f] for f in FAMILLES}
    L.append("### Count by family\n")
    L.append("| Family | Options | Variables | JSON Keys | In production |")
    L.append("| --- | --: | --: | --: | --: |")
    tot = [0, 0, 0, 0]
    for f in FAMILLES:
        o = sum(1 for r in par_famille[f] if r["source"] == "option")
        v = sum(1 for r in par_famille[f] if r["source"] == "variable")
        j = sum(1 for e in table["json"] if e["famille"] == f)
        pr = sum(1 for r in par_famille[f] if (r["source"] == "variable" and r["variable"] in prod_vars) or
                 (r["source"] == "option" and any(op in s for s in prod_opts.values() for op in r["options"])))
        tot = [tot[0] + o, tot[1] + v, tot[2] + j, tot[3] + pr]
        L.append(f"| {f} | {o} | {v} | {j} | {pr} |")
    L.append(f"| **total** | **{tot[0]}** | **{tot[1]}** | **{tot[2]}** | **{tot[3]}** |")
    L.append("")
    if not prod_vars and not prod_opts:
        L.append("Production files missing on this machine: « production » columns empty.\n")
    else:
        L.append("Production : " + ", ".join(p.name for p in prod_env if p.is_file()) +
                 (", " + prod_yaml.name + " (" + ", ".join(sorted(prod_opts)) + ")" if prod_opts else "") +
                 ". Paths, hosts and keys are masked.\n")

    def cell(t: object) -> str:
        return str(t).replace("|", "\\|").replace("\n", " ")

    for f in FAMILLES:
        rs = par_famille[f]
        if not rs:
            continue
        L.append(f"### {f}\n")
        L.append("| Key | Status | Option | Variable (old names) | Type | Default | Read at | Production | m1-ultra profile "
                 "| Aide |")
        L.append("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
        for r in rs:
            if r["source"] == "derive":
                option = f"`--{r['cle']}`"
                var = f"`{r['variable']}` (pose " + ", ".join(f"`{k}={v}`" for k, v in r["pose"].items()) + ")"
                pr = ""
            elif r["source"] == "option":
                option = ", ".join(f"`{o}`" for o in r["options"]) + f", `--{r['cle']}`"
                var = f"`{r['variable']}`" if r["variable"] else ""
                pr = "; ".join(f"{s} `{v}`" if v != "oui" and "/" not in v else f"{s}"
                               for s, opts in sorted(prod_opts.items()) for o, v in opts.items() if o in r["options"])
            else:
                option = f"`--{r['cle']}`"
                var = f"`{r['variable']}`"
                if r.get("alias"):
                    var += f" or `{r['alias']}`"
                if r["anciens"]:
                    var += " (" + ", ".join(f"`{a}`" for a in r["anciens"]) + ")"
                pr = "; ".join(prod_vars.get(r["variable"], []))
                if noms_prod.get(r["variable"]):
                    pr += " (nom ancien : " + ", ".join(noms_prod[r["variable"]]) + ")"
            typ = r["type"] + (" : " + "/".join(r["choix"]) if r["choix"] and r["type"] != "drapeau" else "")
            d = r["defaut"]
            defaut = "" if d is None else f"`{d}`" if d != "" else "vide"
            lu = "<br>".join(f"`{l}`" for l in r["lu"][:2]) + (f" (+{len(r['lu']) - 2})" if len(r["lu"]) > 2 else "")
            aide = r["aide"] + ("" if not r.get("doc_statut") else f" *[switches.md : {r['doc_statut']}]*")
            if r.get("note"):
                aide += f" *Note : {r['note']}.*"
            if r["alertes"]:
                aide += " **To check : " + "; ".join(r["alertes"]) + ".**"
            statut = r["statut"] + (" (?)" if r.get("doute") else "")
            L.append("| " + " | ".join(cell(x) for x in (f"`{r['cle']}`", statut, option, var, typ, defaut, lu, pr,
                                                           "; ".join(profil.get(r["variable"], [])) if r["source"] ==
                                                           "variable" else "", aide)) + " |")
        L.append("")

    # JSON keys
    js = cles_json(prod_json)
    L.append("### JSON keys for generation (gen, gen.voix, gen.image, gen.video, gen.lora)\n")
    L.append("File passed via `PLI_GEN_CONFIG` (pli-gen.json) and files it names (voix, catalogues). "
             "`<nom>`: free name (family, model, voix, LoRA).\n")
    L.append("| Family | File | Key | Type | Read at | Example from repo | Production |")
    L.append("| --- | --- | --- | --- | --- | --- | --- |")
    for e in js:
        L.append("| " + " | ".join(cell(x) for x in (
            e["famille"], e["fichier"], f"`{e['chemin']}`", e["type"],
            "<br>".join(f"`{l}`" for l in e["lu"][:2]) or "**not found**",
            "oui" if e["exemples"] else "non", "oui" if e["production"] else "")) + " |")
    L.append("")

    # Statuts
    L.append("### Statuts\n")
    L.append("| Status | Settings | Of which deployed in reference production |")
    L.append("| --- | --: | --: |")
    pv, po = production_reference()
    for s in ("recommande", "experimental", "obsolete"):
        rs = [r for r in regs if r["statut"] == s]
        n = sum(1 for r in rs if (r["source"] == "variable" and r["variable"] in pv) or
                (r["source"] == "option" and po & set(r["options"])))
        L.append(f"| {s} | {len(rs)} | {n} |")
    L.append("")
    L.append("Doubtful cases (marked « (?) » in the tables): proposed status, to be confirmed.\n")
    for r in regs:
        if r.get("doute"):
            L.append(f"- `{r['cle']}` (`{r['variable'] or r['options'][0]}`): proposed **{r['statut']}**; "
                     f"{r['doute']}.")
    L.append("")

    # Settings to review
    L.append("### Dead, duplicate or inconsistent settings (automatic survey)\n")
    for r in regs:
        if r["alertes"]:
            L.append(f"- `{r['cle']}` (`{r['variable'] or r['options'][0]}`) : " + "; ".join(r["alertes"]) + ".")
    for nom in sorted(prod_vars):
        if not any(r["variable"] == nom for r in regs) and not nom.startswith("MLX_"):
            L.append(f"- `{nom}` is deployed in production but not read anywhere in src/ (dead setting).")
    L.append("")
    L.append(FIN)
    return "\n".join(L)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--verifier", action="store_true", help="exit code 1 if table.json is no longer up to date")
    ap.add_argument("--prod-env", action="append", type=Path, help="production .env file (read-only)")
    ap.add_argument("--prod-yaml", type=Path, default=PROD_YAML)
    ap.add_argument("--prod-json", action="append", type=Path)
    ap.add_argument("--sans-prod", action="store_true", help="do not read any production file")
    a = ap.parse_args()
    table = construire_table()
    texte = json.dumps(table, ensure_ascii=False, indent=1, sort_keys=False) + "\n"
    if a.verifier:
        actuel = TABLE.read_text() if TABLE.is_file() else ""
        if actuel != texte:
            print("table.json is no longer up to date: rerun tools/pli-reglages-inventaire", file=sys.stderr)
            return 1
        print("table.json up to date")
        return 0
    TABLE.write_text(texte)
    env = [] if a.sans_prod else (a.prod_env or PROD_ENV)
    yaml = Path("/nonexistent") if a.sans_prod else a.prod_yaml
    pj = [] if a.sans_prod else (a.prod_json or PROD_JSON)
    bloc = ecrire_doc(table, env, yaml, pj)
    ancien = DOC.read_text() if DOC.is_file() else "# PLI Settings\n\n## Inventory\n\n" + DEBUT + "\n" + FIN + "\n"
    if DEBUT in ancien and FIN in ancien:
        nouveau = ancien[: ancien.index(DEBUT)] + bloc + ancien[ancien.index(FIN) + len(FIN):]
    else:
        nouveau = ancien.rstrip() + "\n\n" + bloc + "\n"
    DOC.write_text(nouveau)
    n = len(table["reglages"])
    print(f"{n} settings ({sum(r['source'] == 'option' for r in table['reglages'])} options, "
          f"{sum(r['source'] == 'variable' for r in table['reglages'])} variables), {len(table['json'])} JSON keys "
          f"example; wrote {TABLE.relative_to(RACINE)} and {DOC.relative_to(RACINE)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
