@@ -67,6 +68,21 @@ typedef struct {
     h3_dit_stream_source sources[STREAM_MATRICES];
 } h3_dit_stream_layer;
 
+/* In-memory LoRA: for one matrix, the requested LoRA concatenated along the rank (up already multiplied by the
+ * force), added to the BF16 weight each time the block is loaded. */
+typedef struct {
+    h3_gpu_tensor *up;
+    h3_gpu_tensor *down_t;
+    uint32_t rank;
+} h3_dit_lora;
+
+enum { H3_LORA_MAX = 8 };
+static struct {
+    char *path;
+    float force;
+} h3_lora_specs[H3_LORA_MAX];
+static unsigned h3_lora_spec_count;
+
 struct h3_dit {
     h3_gpu *gpu;
     h3_weight_store *weights;
@@ -140,6 +156,10 @@ struct h3_dit {
     h3_dit_block blocks[H3_DIT_BLOCKS];
     h3_dit_block stream_slots[2];
     h3_dit_stream_layer stream_layers[H3_DIT_BLOCKS];
+    h3_dit_lora lora_blocks[H3_DIT_BLOCKS][STREAM_MATRICES];
+    h3_dit_lora lora_refiner[2][STREAM_MATRICES];
+    h3_gpu_tensor *lora_delta;
+    int lora_active;
     unsigned stream_ready_layer;
     unsigned stream_ready_slot;
     uint64_t stream_bytes;
@@ -499,6 +519,231 @@ static uint32_t token_reduced_parent(const h3_dit *dit, uint32_t full_row) {
            (local % spatial_width) / 2;
 }
 
+int h3_dit_add_lora(const char *spec, char *error, size_t error_size) {
+    if (!spec || !*spec) {
+        fail(error, error_size, "--lora: empty value");
+        return 0;
+    }
+    if (h3_lora_spec_count >= H3_LORA_MAX) {
+        fail(error, error_size, "--lora: at most %d LoRA", H3_LORA_MAX);
+        return 0;
+    }
+    char *path = strdup(spec);
+    if (!path) {
+        fail(error, error_size, "--lora: out of memory");
+        return 0;
+    }
+    float force = 1.0f;
+    char *at = strrchr(path, '@');
+    if (at) {
+        char *end = NULL;
+        double value = strtod(at + 1, &end);
+        if (end && end != at + 1 && *end == '\0') {
+            if (!(value >= -10.0 && value <= 10.0)) {
+                fail(error, error_size, "--lora %s: force outside [-10, 10]", spec);
+                free(path);
+                return 0;
+            }
+            force = (float)value;
+            *at = '\0';
+        }
+    }
+    h3_lora_specs[h3_lora_spec_count].path = path;
+    h3_lora_specs[h3_lora_spec_count].force = force;
+    h3_lora_spec_count++;
+    return 1;
+}
+
+unsigned h3_dit_lora_count(void) { return h3_lora_spec_count; }
+
+static uint16_t lora_scale_bf16(uint16_t value, float force) {
+    uint32_t bits = (uint32_t)value << 16;
+    float f;
+    memcpy(&f, &bits, sizeof(f));
+    f *= force;
+    memcpy(&bits, &f, sizeof(bits));
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return (uint16_t)(bits >> 16);
+}
+
+/* One matrix: finds NAME.lora_up [rows x r] and NAME.lora_down_t [columns x r] in each LoRA, concatenates them
+ * (up multiplied by the force) and uploads them to the GPU. *used counts the tensors read per LoRA. */
+static int lora_load_matrix(h3_dit *dit, h3_dit_lora *target,
+                            h3_st_header *headers, unsigned *used,
+                            const char *name, uint32_t rows, uint32_t columns,
+                            uint64_t *bytes, char *error, size_t error_size) {
+    char up_name[200], down_name[200];
+    snprintf(up_name, sizeof(up_name), "%s.lora_up", name);
+    snprintf(down_name, sizeof(down_name), "%s.lora_down_t", name);
+    uint64_t total = 0;
+    const h3_st_tensor *ups[H3_LORA_MAX], *downs[H3_LORA_MAX];
+    for (unsigned l = 0; l < h3_lora_spec_count; l++) {
+        ups[l] = h3_st_find(&headers[l], up_name);
+        downs[l] = h3_st_find(&headers[l], down_name);
+        if (!ups[l] && !downs[l]) continue;
+        if (!ups[l] || !downs[l] || ups[l]->dtype != H3_DTYPE_BF16 ||
+            downs[l]->dtype != H3_DTYPE_BF16 || ups[l]->ndim != 2 ||
+            downs[l]->ndim != 2 || ups[l]->shape[0] != rows ||
+            downs[l]->shape[0] != columns ||
+            ups[l]->shape[1] != downs[l]->shape[1] || ups[l]->shape[1] == 0) {
+            fail(error, error_size, "LoRA %s: %s has the wrong schema",
+                 h3_lora_specs[l].path, name);
+            return 0;
+        }
+        total += ups[l]->shape[1];
+    }
+    if (!total) return 1;
+    if (total > 4096) {
+        fail(error, error_size, "LoRA on %s: total rank %llu above 4096", name,
+             (unsigned long long)total);
+        return 0;
+    }
+    size_t rank = (size_t)total;
+    uint16_t *up = calloc((size_t)rows * rank, sizeof(uint16_t));
+    uint16_t *down = calloc((size_t)columns * rank, sizeof(uint16_t));
+    uint16_t *scratch = malloc((size_t)(rows > columns ? rows : columns) * rank *
+                               sizeof(uint16_t));
+    int ok = up && down && scratch;
+    if (!ok) fail(error, error_size, "LoRA on %s: out of memory", name);
+    size_t column = 0;
+    for (unsigned l = 0; ok && l < h3_lora_spec_count; l++) {
+        if (!ups[l]) continue;
+        size_t r = (size_t)ups[l]->shape[1];
+        ok = h3_st_read_data(&headers[l], ups[l], scratch,
+                             (size_t)rows * r * sizeof(uint16_t),
+                             error, error_size);
+        for (size_t i = 0; ok && i < rows; i++)
+            for (size_t j = 0; j < r; j++)
+                up[i * rank + column + j] =
+                    lora_scale_bf16(scratch[i * r + j], h3_lora_specs[l].force);
+        ok = ok && h3_st_read_data(&headers[l], downs[l], scratch,
+                                   (size_t)columns * r * sizeof(uint16_t),
+                                   error, error_size);
+        for (size_t i = 0; ok && i < columns; i++)
+            memcpy(&down[i * rank + column], &scratch[i * r], r * sizeof(uint16_t));
+        used[l] += 2;
+        column += r;
+    }
+    if (ok) {
+        target->up = h3_gpu_tensor_from_bf16(dit->gpu, up, (size_t)rows * rank);
+        target->down_t = h3_gpu_tensor_from_bf16(dit->gpu, down,
+                                                 (size_t)columns * rank);
+        target->rank = (uint32_t)rank;
+        ok = target->up && target->down_t;
+        if (!ok) fail(error, error_size, "LoRA on %s: cannot allocate GPU tensors", name);
+        *bytes += ((uint64_t)rows + columns) * rank * sizeof(uint16_t);
+    }
+    free(up);
+    free(down);
+    free(scratch);
+    return ok;
+}
+
+static const struct {
+    const char *suffix;
+    uint32_t rows, columns;
+} lora_matrices[STREAM_MATRICES] = {
+    [STREAM_QKV] = {"attn.qkv_proj", INNER * 3, HIDDEN},
+    [STREAM_OUT] = {"attn.out_proj", HIDDEN, INNER},
+    [STREAM_FC1] = {"mlp.fc1", FFN * 2, HIDDEN},
+    [STREAM_FC2] = {"mlp.fc2", HIDDEN, FFN},
+};
+
+static int lora_load_all(h3_dit *dit, char *error, size_t error_size) {
+    if (!h3_lora_spec_count) return 1;
+    h3_st_header headers[H3_LORA_MAX];
+    unsigned used[H3_LORA_MAX] = {0};
+    memset(headers, 0, sizeof(headers));
+    int ok = 1;
+    for (unsigned l = 0; ok && l < h3_lora_spec_count; l++)
+        ok = h3_st_read_header(h3_lora_specs[l].path, &headers[l], error,
+                               error_size);
+    uint64_t bytes = 0;
+    unsigned matrices = 0;
+    char name[160];
+    for (unsigned b = 0; ok && b < H3_DIT_BLOCKS + 2; b++) {
+        for (unsigned m = 0; ok && m < STREAM_MATRICES; m++) {
+            if (b < H3_DIT_BLOCKS)
+                snprintf(name, sizeof(name), "blocks.%u.%s", b, lora_matrices[m].suffix);
+            else
+                snprintf(name, sizeof(name), "token_refiner.blocks.%u.%s",
+                         b - H3_DIT_BLOCKS, lora_matrices[m].suffix);
+            h3_dit_lora *target = b < H3_DIT_BLOCKS ? &dit->lora_blocks[b][m]
+                                                    : &dit->lora_refiner[b - H3_DIT_BLOCKS][m];
+            ok = lora_load_matrix(dit, target, headers, used, name,
+                                  lora_matrices[m].rows, lora_matrices[m].columns,
+                                  &bytes, error, error_size);
+            if (ok && target->up) matrices++;
+        }
+    }
+    for (unsigned l = 0; ok && l < h3_lora_spec_count; l++) {
+        if (used[l] != headers[l].tensor_count || !used[l]) {
+            fail(error, error_size,
+                 "LoRA %s: %zu tensors, %u applied (h3-lora-natif file expected, "
+                 "made by pli-lora-natif)",
+                 h3_lora_specs[l].path, headers[l].tensor_count, used[l]);
+            ok = 0;
+        }
+    }
+    for (unsigned l = 0; l < h3_lora_spec_count; l++) h3_st_free_header(&headers[l]);
+    if (!ok) return 0;
+    dit->lora_delta = h3_gpu_tensor_new_f32(dit->gpu, (size_t)FFN * 2 * HIDDEN);
+    if (!dit->lora_delta) {
+        fail(error, error_size, "cannot allocate the LoRA delta buffer");
+        return 0;
+    }
+    dit->lora_active = 1;
+    fprintf(stderr, "h3: in-memory LoRA: %u file(s), %u matrices, %.2f GiB\n",
+            h3_lora_spec_count, matrices, (double)bytes / (1024.0 * 1024.0 * 1024.0));
+    for (unsigned l = 0; l < h3_lora_spec_count; l++)
+        fprintf(stderr, "h3:   %s force %g\n", h3_lora_specs[l].path,
+                (double)h3_lora_specs[l].force);
+    return 1;
+}
+
+/* Encodes, in the open GPU command, the LoRA update of a block's four matrices. */
+static int lora_apply_block(h3_dit *dit, const h3_dit_lora *mats,
+                            h3_dit_block *block, char *error, size_t error_size) {
+    if (!dit->lora_active) return 1;
+    h3_gpu_tensor *weights[STREAM_MATRICES];
+    weights[STREAM_QKV] = block->qkv;
+    weights[STREAM_OUT] = block->out;
+    weights[STREAM_FC1] = block->fc1;
+    weights[STREAM_FC2] = block->fc2;
+    for (unsigned m = 0; m < STREAM_MATRICES; m++) {
+        if (!mats[m].up) continue;
+        if (!gpu_op(dit, h3_gpu_lora_merge_bf16(
+                        dit->gpu, weights[m], mats[m].up, mats[m].down_t,
+                        dit->lora_delta, lora_matrices[m].rows, mats[m].rank,
+                        lora_matrices[m].columns),
+                    error, error_size, "apply LoRA")) return 0;
+    }
+    return 1;
+}
+
+/* Outside the compute stream (resident load, refiner): a separate command, waited for. */
+static int lora_apply_block_now(h3_dit *dit, const h3_dit_lora *mats,
+                                h3_dit_block *block, char *error, size_t error_size) {
+    if (!dit->lora_active) return 1;
+    return gpu_op(dit, h3_gpu_begin(dit->gpu), error, error_size, "begin LoRA") &&
+           lora_apply_block(dit, mats, block, error, error_size) &&
+           gpu_op(dit, h3_gpu_submit(dit->gpu), error, error_size, "submit LoRA");
+}
+
+static void lora_free(h3_dit *dit) {
+    for (unsigned b = 0; b < H3_DIT_BLOCKS; b++)
+        for (unsigned m = 0; m < STREAM_MATRICES; m++) {
+            h3_gpu_tensor_free(dit->lora_blocks[b][m].up);
+            h3_gpu_tensor_free(dit->lora_blocks[b][m].down_t);
+        }
+    for (unsigned b = 0; b < 2; b++)
+        for (unsigned m = 0; m < STREAM_MATRICES; m++) {
+            h3_gpu_tensor_free(dit->lora_refiner[b][m].up);
+            h3_gpu_tensor_free(dit->lora_refiner[b][m].down_t);
+        }
+    h3_gpu_tensor_free(dit->lora_delta);
+}
+
 static int load_block(h3_dit *dit, h3_dit_block *block, const char *prefix,
                       char *error, size_t error_size) {
     char name[160];
@@ -819,7 +1064,11 @@ static int refine_text(h3_dit *dit, const h3_text_embedding *text,
         load_block(dit, &refiner[0], "token_refiner.blocks.0.",
                    error, error_size) &&
         load_block(dit, &refiner[1], "token_refiner.blocks.1.",
-                   error, error_size);
+                   error, error_size) &&
+        lora_apply_block_now(dit, dit->lora_refiner[0], &refiner[0],
+                             error, error_size) &&
+        lora_apply_block_now(dit, dit->lora_refiner[1], &refiner[1],
+                             error, error_size);
     if (ok) final_norm = bf1(dit, "token_refiner.final_norm.weight", HIDDEN,
                              error, error_size);
     size_t rows = dit->text_rows;
@@ -1255,7 +1504,10 @@ static int load_core(h3_dit *dit, h3_dit_progress progress, void *opaque,
                 return 0;
         } else {
             if (!load_block(dit, &dit->blocks[index], prefix,
-                            error, error_size)) return 0;
+                            error, error_size) ||
+                !lora_apply_block_now(dit, dit->lora_blocks[index],
+                                      &dit->blocks[index], error, error_size))
+                return 0;
             if (dit->int8_mlp &&
                 !quantize_block_mlp(dit, &dit->blocks[index],
                                     error, error_size)) return 0;
@@ -1663,6 +1915,7 @@ static h3_dit *load_dit(const char *weight_directory,
          getenv("H3_BENCH_INT8_MLP_AB") ||
          getenv("H3_INT8_MLP_STAGE"));
     h3_gpu_profile_set_label(dit->gpu, "H3 DiT");
+    if (!lora_load_all(dit, error, error_size)) goto failed;
     report(progress, progress_opaque, "refine text", 0, 1);
     if (!refine_text(dit, text, error, error_size)) goto failed;
     report(progress, progress_opaque, "refine text", 1, 1);
@@ -2236,6 +2489,8 @@ static int encode_forward(h3_dit *dit, int step, int begin, int submit,
                 streamed_weight.fc1 = slot->fc1;
                 streamed_weight.fc2 = slot->fc2;
                 weight = &streamed_weight;
+                if (!lora_apply_block(dit, dit->lora_blocks[block], slot,
+                                      error, error_size)) return 0;
 
                 unsigned future = next_active_block(dit, block);
                 if (future == H3_DIT_BLOCKS)
@@ -2994,6 +3249,7 @@ int h3_dit_denoise_euler(h3_dit *dit, float *video_latent,
 
 void h3_dit_free(h3_dit *dit) {
     if (!dit) return;
+    lora_free(dit);
     int steps = h3_dit_schedule_steps(dit->schedule);
     if (dit->row_maps) for (int step = 0; step < steps; step++)
