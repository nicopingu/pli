         });
 }
+
+/* In-memory LoRA. Graph: up and down_t BF16 cast to F32, delta = up @ down_t^T in F32. */
+static H3Linear *h3_gpu_lora_graph(H3GPU *gpu, uint32_t out_dim, uint32_t rank,
+                                   uint32_t in_dim) {
+    @autoreleasepool {
+        NSString *key = [NSString stringWithFormat:@"lora:%u:%u:%u", out_dim,
+                         rank, in_dim];
+        H3Linear *cached = gpu.linearCache[key];
+        if (cached) return cached;
+        H3Linear *lora = [[H3Linear alloc] init];
+        lora.graph = [[MPSGraph alloc] init];
+        lora.inputShape = @[@1, @(out_dim), @(rank)];
+        lora.weightShape = @[@1, @(in_dim), @(rank)];
+        lora.outputShape = @[@1, @(out_dim), @(in_dim)];
+        lora.input = [lora.graph placeholderWithShape:lora.inputShape
+                                             dataType:MPSDataTypeBFloat16 name:nil];
+        lora.weight = [lora.graph placeholderWithShape:lora.weightShape
+                                              dataType:MPSDataTypeBFloat16 name:nil];
+        MPSGraphTensor *up = [lora.graph castTensor:lora.input
+                                             toType:MPSDataTypeFloat32 name:nil];
+        MPSGraphTensor *down = [lora.graph castTensor:lora.weight
+                                               toType:MPSDataTypeFloat32 name:nil];
+        MPSGraphTensor *transposed = [lora.graph transposeTensor:down dimension:1
+                                                   withDimension:2 name:nil];
+        lora.output = [lora.graph matrixMultiplicationWithPrimaryTensor:up
+                                                       secondaryTensor:transposed
+                                                                  name:nil];
+        gpu.linearCache[key] = lora;
+        return lora;
+    }
+}
+
+int h3_gpu_lora_merge_bf16(h3_gpu *opaque, h3_gpu_tensor *weight,
+                           const h3_gpu_tensor *up, const h3_gpu_tensor *down_t,
+                           h3_gpu_tensor *delta, uint32_t out_dim,
+                           uint32_t rank, uint32_t in_dim) {
+    H3GPU *gpu = GPU(opaque);
+    size_t count = (size_t)out_dim * in_dim;
+    if (count > UINT32_MAX) {
+        h3_gpu_set_error(gpu, @"LoRA weight too large");
+        return 0;
+    }
+    if (!h3_gpu_require_bf16(gpu, weight, count, @"LoRA weight") ||
+        !h3_gpu_require_bf16(gpu, up, (size_t)out_dim * rank, @"LoRA up") ||
+        !h3_gpu_require_bf16(gpu, down_t, (size_t)in_dim * rank, @"LoRA down") ||
+        !h3_gpu_require_elements(gpu, delta, count, @"LoRA delta") ||
+        TENSOR(delta).dtype != H3_GPU_F32) return 0;
+    if (!h3_gpu_require_command(gpu)) return 0;
+    H3Linear *lora = h3_gpu_lora_graph(gpu, out_dim, rank, in_dim);
+    if (!lora) return 0;
+    @autoreleasepool {
+        MPSCommandBuffer *command = h3_gpu_mps_command(gpu);
+        MPSGraphTensorData *up_data = h3_gpu_graph_data(
+            up, lora.inputShape, MPSDataTypeBFloat16, 1);
+        MPSGraphTensorData *down_data = h3_gpu_graph_data(
+            down_t, lora.weightShape, MPSDataTypeBFloat16, 1);
+        MPSGraphTensorData *delta_data = h3_gpu_graph_data(
+            delta, lora.outputShape, MPSDataTypeFloat32, 0);
+        @try {
+            [lora.graph encodeToCommandBuffer:command
+                                        feeds:@{lora.input: up_data, lora.weight: down_data}
+                             targetOperations:nil
+                            resultsDictionary:@{lora.output: delta_data}
+                          executionDescriptor:nil];
+        } @catch (NSException *exception) {
+            h3_gpu_set_error(gpu, @"MPSGraph LoRA failed: %@", exception.reason);
+            return 0;
+        }
+        gpu.command = command.rootCommandBuffer;
+    }
+    uint32_t elements = (uint32_t)count;
+    return h3_gpu_dispatch_1d(gpu, @"h3_lora_add_bf16", elements,
+        ^(id<MTLComputeCommandEncoder> encoder) {
+            [encoder setBuffer:TENSOR(weight).buffer offset:0 atIndex:0];
+            [encoder setBuffer:TENSOR(delta).buffer offset:0 atIndex:1];
+            [encoder setBytes:&elements length:sizeof(elements) atIndex:2];
+        });
+}
diff --git a/h3_shaders.metal b/h3_shaders.metal
index 36316f5..53d7f79 100644
--- a/h3_shaders.metal
+++ b/h3_shaders.metal
@@ -4330,3 +4330,13 @@ kernel void h3_silu_mul_bf16(device const ushort *gate [[buffer(0)]],
     float other = h3_bf16_to_f32(up[gid]);
     output[gid] = h3_f32_to_bf16(value / (1.0f + exp(-value)) * other);
 }
+
+/* In-memory LoRA: BF16 weight += F32 delta (force * up @ down_t^T), a single round-to-nearest-even, as a fusion
+ * on disk does. */
+kernel void h3_lora_add_bf16(device ushort *weight [[buffer(0)]],
+                             device const float *delta [[buffer(1)]],
+                             constant uint &count [[buffer(2)]],
+                             uint gid [[thread_position_in_grid]]) {
+    if (gid >= count) return;
+    weight[gid] = h3_f32_to_bf16(h3_bf16_to_f32(weight[gid]) + delta[gid]);
+}
