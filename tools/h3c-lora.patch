+/* In-memory LoRA: FILE[@FORCE] in the h3-lora-natif format (tool pli-lora-natif). Call before loading; several
+ * LoRA add up. Returns 0 and fills error if the specification is invalid. */
+int h3_dit_add_lora(const char *spec, char *error, size_t error_size);
+unsigned h3_dit_lora_count(void);
+
 /* Load a text-only FL2VA transformer. Text refinement and AdaLN precomputation
  * happen before the persistent core is loaded. SSD streaming retains only the
  * small block norms and two alternating BF16 matrix slots. */
diff --git a/h3_gpu.h b/h3_gpu.h
index 3a47cc3..35eda4b 100644
