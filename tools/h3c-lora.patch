+++ b/h3_gpu.h
@@ -537,6 +537,12 @@ int h3_gpu_gqa_causal_bf16(h3_gpu *gpu, h3_gpu_tensor *output,
                            uint32_t sequence, uint32_t query_heads,
                            uint32_t kv_heads, uint32_t head_dim,
                            float scale);
+/* In-memory LoRA: weight[out x in] (BF16) += up[out x rank] @ down_t[in x rank]^T, computed in F32 (MPSGraph)
+ * into delta (F32, at least out * in elements), then a single BF16 rounding. */
+int h3_gpu_lora_merge_bf16(h3_gpu *gpu, h3_gpu_tensor *weight,
+                           const h3_gpu_tensor *up, const h3_gpu_tensor *down_t,
+                           h3_gpu_tensor *delta, uint32_t out_dim,
+                           uint32_t rank, uint32_t in_dim);
