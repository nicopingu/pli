#!/usr/bin/env python3
"""pli-lora-natif: converts a MiniMax-H3 LoRA to the native layout of h3.c, to be applied in memory (h3 --lora).

    pli-lora-natif MODELE LORA SORTIE.safetensors [--qkv auto|comfy|natif] [--essai]

PLI 5.6.5. Instead of writing a fused copy of the transformer (pli-lora-fusion, 33 to 62 GB per LoRA), the LoRA is
converted once to a small file, and h3 adds force * up @ down_t^T to each block's BF16 weights as it loads them
(h3.c with the patch tools/h3c-lora.patch, option --lora FILE@FORCE, repeatable). Several LoRA can then be combined
in one video. The PLI video child process calls this tool itself (key "lora_natif" in its catalog).

Same key reading and correspondence as pli-lora-fusion (loaded from the same folder): native, Kohya, Comfy (qkv
contiguous -> interleaved by head), PEFT diffusers (to_q/k/v placed on their native rows, fc1 [value; gate] ->
[gate; value], alpha read in __metadata__). LoKr is refused (not low rank), and so is any target that is not a BF16
matrix of the model.

Output, for each tensor T.weight of the model touched by the LoRA:
  T.lora_up     BF16 [native rows x R]: B in the native layout, times alpha/rank (the force is applied by h3)
  T.lora_down_t BF16 [columns x R]: A transposed
with R the sum of the ranks placed on that tensor (3 r for qkv in PEFT). Exit codes: 0 written, 2 refused (nothing
written). Dependency: numpy (not needed for --essai).
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import struct
import sys

VERSION = 1


def _fusion():
    """pli-lora-fusion, from the same folder (one key reading for both tools)."""

    chemin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "pli-lora-fusion")
    chargeur = importlib.machinery.SourceFileLoader("pli_lora_fusion", chemin)
    spec = importlib.util.spec_from_loader(chargeur.name, chargeur)
    module = importlib.util.module_from_spec(spec)
    chargeur.exec_module(module)
    return module


F = _fusion()


def die(msg, code=2):
    print("REFUS : " + msg, file=sys.stderr)
    sys.exit(code)


def index_modele(root):
    """-> (weight_map, header by shard) of the native transformer."""

    for rel in ("FL2VA/transformer", "transformer"):
        tdir = os.path.join(root, rel)
        if os.path.isfile(os.path.join(tdir, "config.json")):
            break
    else:
        die(f"no transformer under {root} (FL2VA/transformer or transformer)")
    idx = sorted(x for x in os.listdir(tdir) if x.endswith(".safetensors.index.json"))
    if idx:
        wm = json.load(open(os.path.join(tdir, idx[0])))["weight_map"]
    else:
        wm = {}
        for s in sorted(x for x in os.listdir(tdir) if x.endswith(".safetensors")):
            wm.update({k: s for k in F.read_header(os.path.join(tdir, s))[1]})
    heads = {s: F.read_header(os.path.join(tdir, s))[1] for s in sorted(set(wm.values()))}
    if not any(k.startswith("blocks.") for k in wm):
        die("native names missing (blocks.N.attn.qkv_proj.weight)")
    return wm, heads


def analyser(lp, wm, heads, qkv):
    """-> (contributions by tensor, layout, problems); same analysis as pli-lora-fusion."""

    mods, errs, prefixes, meta = F.parse_lora(lp)
    bad = list(errs)
    if prefixes == {"diffusers"}:
        layout = "diffusers"
    elif "diffusers" in prefixes:
        bad.append("PEFT diffusers keys mixed with other formats")
        layout = "diffusers"
    elif qkv != "auto":
        layout = qkv
    elif len(prefixes) == 1:
        layout = next(iter(prefixes))
    else:
        bad.append("Comfy and native keys mixed, set --qkv")
        layout = "natif"
    contribs = {}
    for (tname, qtag), d in mods.items():
        tag = tname + (f" [{qtag}]" if qtag else "")
        if tname not in wm:
            bad.append(f"{tag} (no matching tensor in the model)")
            continue
        W = heads[wm[tname]][tname]
        if len(W["shape"]) != 2 or W["dtype"] != "BF16":
            bad.append(f"{tag} (target {W['dtype']} {W['shape']}: a BF16 matrix is expected)")
            continue
        out, inn = W["shape"]
        if set(d) - {"alpha"} != {"up", "down"}:
            bad.append(f"{tag} (keys {sorted(set(d))}: only an A/B LoRA is applied in memory)")
            continue
        up, down = d["up"][2], d["down"][2]
        exp_rows = out // 3 if qtag else out
        if len(up["shape"]) != 2 or len(down["shape"]) != 2 or up["shape"][1] != down["shape"][0] \
                or up["shape"][0] != exp_rows or down["shape"][1] != inn:
            bad.append(f"{tag} (shapes B{up['shape']} A{down['shape']} vs W{W['shape']})")
            continue
        r = down["shape"][0]
        alpha = r
        if layout == "diffusers":
            try:
                alpha = float(meta["alpha"])
                if not 0 < alpha < float("inf"):
                    raise ValueError
            except (KeyError, ValueError, TypeError):
                bad.append(f"{tag} (PEFT: __metadata__[alpha] missing or invalid)")
                continue
        elif "alpha" in d:
            if d["alpha"][2]["shape"] != []:
                bad.append(f"{tag} (alpha is not a scalar)")
                continue
            alpha = F.read_scalar(d["alpha"][0], d["alpha"][1], d["alpha"][2])
        op = None
        if layout == "diffusers" and qtag:
            op = "qkv-peft"
        elif layout == "diffusers" and tname.endswith("mlp.fc1.weight"):
            op = "fc1-swap"
        elif layout == "comfy" and tname.endswith("attn.qkv_proj.weight"):
            op = "qkv-comfy"
        contribs.setdefault(tname, []).append(dict(up=d["up"], down=d["down"], coef=alpha / r, rank=r,
                                                  op=op, tag=qtag, out=out, inn=inn))
    if layout == "diffusers":
        for tn, cs in contribs.items():
            tg = sorted(c["tag"] for c in cs if c["op"] == "qkv-peft")
            if tg and tg != ["k", "q", "v"]:
                bad.append(f"{tn}: q/k/v incomplete ({tg})")
    return contribs, layout, bad


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("modele")
    ap.add_argument("lora")
    ap.add_argument("sortie")
    ap.add_argument("--qkv", choices=("auto", "comfy", "natif"), default="auto")
    ap.add_argument("--essai", action="store_true", help="check keys and shapes, write nothing")
    a = ap.parse_args()
    if not os.path.isfile(a.lora):
        die(f"LoRA not found: {a.lora}")
    wm, heads = index_modele(os.path.abspath(a.modele))
    contribs, layout, bad = analyser(os.path.abspath(a.lora), wm, heads, a.qkv)
    if bad:
        for b in bad[:40]:
            print("  - " + b, file=sys.stderr)
        die(f"{len(bad)} problem(s), nothing written")
    if not contribs:
        die("no tensor touched")
    ranks = sorted({c["rank"] for cs in contribs.values() for c in cs})
    print(f"{os.path.basename(a.lora)}: layout {layout}, {len(contribs)} tensors, ranks {ranks}")
    if a.essai:
        return
    import numpy as np

    def load(ref):
        path, ds, t = ref
        b, e = t["data_offsets"]
        with open(path, "rb") as f:
            f.seek(ds + b)
            buf = f.read(e - b)
        if t["dtype"] == "F32":
            x = np.frombuffer(buf, "<f4").astype(np.float32)
        elif t["dtype"] == "F16":
            x = np.frombuffer(buf, "<f2").astype(np.float32)
        else:
            x = (np.frombuffer(buf, "<u2").astype(np.uint32) << 16).view(np.float32)
        return x.reshape(t["shape"])

    def bf16(x):
        u = np.ascontiguousarray(x, dtype=np.float32).view(np.uint32)
        return ((u + (((u >> 16) & 1) + 0x7FFF)) >> 16).astype("<u2")

    tenseurs = []
    for tname in sorted(contribs):
        cs = contribs[tname]
        out, inn = cs[0]["out"], cs[0]["inn"]
        R = sum(c["rank"] for c in cs)
        up = np.zeros((out, R), np.float32)
        down_t = np.zeros((inn, R), np.float32)
        col = 0
        for c in cs:
            B, A = load(c["up"]), load(c["down"])
            r = c["rank"]
            if c["op"] is None:
                up[:, col:col + r] = B * np.float32(c["coef"])
            else:
                src = F.make_src(c, out)
                mk = src >= 0
                up[mk, col:col + r] = B[src[mk]] * np.float32(c["coef"])
            down_t[:, col:col + r] = A.T
            col += r
        base = tname[:-len(".weight")]
        tenseurs.append((base + ".lora_up", [out, R], bf16(up).tobytes()))
        tenseurs.append((base + ".lora_down_t", [inn, R], bf16(down_t).tobytes()))
    head, off = {}, 0
    for nom, forme, b in tenseurs:
        head[nom] = {"dtype": "BF16", "shape": forme, "data_offsets": [off, off + len(b)]}
        off += len(b)
    head["__metadata__"] = {"format": "h3-lora-natif", "version": str(VERSION), "disposition": layout,
                            "source_taille": str(os.path.getsize(a.lora))}
    hj = json.dumps(head, separators=(",", ":")).encode()
    hj += b" " * (-len(hj) % 8)
    tmp = a.sortie + ".partiel"
    with open(tmp, "wb") as f:
        f.write(struct.pack("<Q", len(hj)))
        f.write(hj)
        for _, _, b in tenseurs:
            f.write(b)
    os.replace(tmp, a.sortie)
    print(f"written: {a.sortie} ({off / 2**20:.0f} MiB, {len(tenseurs) // 2} matrices)")


if __name__ == "__main__":
    main()
