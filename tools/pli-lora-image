#!/usr/bin/env python3
"""pli-lora-image: converts an image LoRA (Qwen-Image) to the lora_A / lora_B keys read by mflux 0.24.

    pli-lora-image ENTREE.safetensors SORTIE.safetensors [--essai]

Accepted keys: *.lora.down.weight / *.lora.up.weight, *.lora_down.weight / *.lora_up.weight (with or without
*.alpha), *.lora_A.weight / *.lora_B.weight (PEFT format, alpha in the "lora_adapter_metadata" metadata).
The alpha / rank scale is folded into lora_B: the output has no alpha or PEFT metadata, mflux applies it with a
scale of 1 (the request strength is still applied by mflux). rslora, alpha_pattern and rank_pattern are rejected.
F32, F16 and BF16 types are kept as is (calculation in float32, round to nearest even). Any other key: rejected,
nothing is written (code 2). --essai displays what would be written without writing. Dependency: numpy only.

Example: Qwen-Image 2.1 Lightning LoRA (lightx2v), then the "lora" input of the PLI image catalog.
"""
import argparse
import json
import os
import struct
import sys

TAILLE = {"F32": 4, "F16": 2, "BF16": 2}
SUFFIXES = ((".lora.down.weight", ".lora_A.weight"), (".lora.up.weight", ".lora_B.weight"),
            (".lora_down.weight", ".lora_A.weight"), (".lora_up.weight", ".lora_B.weight"),
            (".lora_A.weight", ".lora_A.weight"), (".lora_B.weight", ".lora_B.weight"))


def refus(message: str) -> None:
    print("REFUS : " + message, file=sys.stderr)
    sys.exit(2)


def lire(chemin: str):
    with open(chemin, "rb") as f:
        n = struct.unpack("<Q", f.read(8))[0]
        entete = json.loads(f.read(n))
        donnees = f.read()
    meta = entete.pop("__metadata__", None) or {}
    return entete, meta, donnees


def vers_f32(np, brut: bytes, dtype: str):
    if dtype == "F32":
        return np.frombuffer(brut, "<f4").astype(np.float32)
    if dtype == "F16":
        return np.frombuffer(brut, "<f2").astype(np.float32)
    return (np.frombuffer(brut, "<u2").astype(np.uint32) << 16).view(np.float32)


def depuis_f32(np, x, dtype: str) -> bytes:
    if dtype == "F32":
        return x.astype("<f4").tobytes()
    if dtype == "F16":
        return x.astype("<f2").tobytes()
    u = np.ascontiguousarray(x, dtype=np.float32).view(np.uint32)
    return ((u + (((u >> 16) & 1) + 0x7FFF)) >> 16).astype("<u2").tobytes()


def main() -> None:
    ap = argparse.ArgumentParser(prog="pli-lora-image", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("entree")
    ap.add_argument("sortie")
    ap.add_argument("--essai", action="store_true", help="displays what would be written, writes nothing")
    a = ap.parse_args()
    if not os.path.isfile(a.entree):
        refus(f"fichier introuvable : {a.entree}")
    if os.path.exists(a.sortie):
        refus(f"the output already exists: {a.sortie}")
    entete, meta, donnees = lire(a.entree)

    alpha_peft = None
    if "lora_adapter_metadata" in meta:
        cfg = json.loads(meta["lora_adapter_metadata"])
        alpha_peft = cfg.get("transformer.lora_alpha")
        if cfg.get("transformer.use_rslora") or cfg.get("transformer.alpha_pattern") or cfg.get("transformer.rank_pattern"):
            refus("rslora, alpha_pattern or rank_pattern: not supported")

    try:
        import numpy as np
    except ImportError:
        refus("numpy is required (pip install numpy)")

    def tenseur(cle):
        t = entete[cle]
        if t["dtype"] not in TAILLE:
            refus(f"{cle}: type {t['dtype']} not supported (F32, F16, BF16)")
        debut, fin = t["data_offsets"]
        return vers_f32(np, donnees[debut:fin], t["dtype"]).reshape(t["shape"]), t["dtype"]

    alphas = {}
    for cle in entete:
        if cle.endswith(".alpha"):
            if entete[cle]["shape"] not in ([], [1]):
                refus(f"{cle}: alpha not scalar")
            alphas[cle[: -len(".alpha")]] = float(tenseur(cle)[0].reshape(-1)[0])

    sortie, echelles, problemes = {}, {}, []
    for cle in entete:
        if cle.endswith(".alpha"):
            continue
        for ancien, nouveau in SUFFIXES:
            if cle.endswith(ancien):
                base, nk = cle[: -len(ancien)], cle[: -len(ancien)] + nouveau
                break
        else:
            problemes.append(cle)
            continue
        x, dtype = tenseur(cle)
        if nk.endswith("lora_B.weight"):
            if x.ndim != 2:
                refus(f"{cle} : matrice attendue")
            rang = x.shape[1]
            alpha = alphas.get(base, alpha_peft)
            ech = 1.0 if alpha is None else float(alpha) / rang
            echelles[ech] = echelles.get(ech, 0) + 1
            x = x * np.float32(ech)
        if nk in sortie:
            refus(f"{nk}: two input keys give the same output key")
        sortie[nk] = (x, dtype)
    if problemes:
        refus(f"{len(problemes)} unexpected key(s), nothing is written: " + ", ".join(problemes[:5]))
    na = sum(k.endswith("lora_A.weight") for k in sortie)
    nb = sum(k.endswith("lora_B.weight") for k in sortie)
    if na != nb or na == 0:
        refus(f"incomplete pairs: {na} lora_A for {nb} lora_B")
    print(f"{a.entree}: {na} pairs, alpha/rank scales folded {echelles}, PEFT alpha {alpha_peft}")
    if a.essai:
        print("--essai: nothing was written.")
        return

    nouvel, corps, pos = {}, [], 0
    for k in sorted(sortie):
        x, dtype = sortie[k]
        b = depuis_f32(np, x, dtype)
        nouvel[k] = {"dtype": dtype, "shape": list(x.shape), "data_offsets": [pos, pos + len(b)]}
        corps.append(b)
        pos += len(b)
    h = json.dumps(nouvel, separators=(",", ":")).encode()
    h += b" " * (-len(h) % 8)
    os.makedirs(os.path.dirname(os.path.abspath(a.sortie)), exist_ok=True)
    temp = a.sortie + ".partiel"
    with open(temp, "wb") as f:
        f.write(struct.pack("<Q", len(h)) + h)
        for b in corps:
            f.write(b)
    os.replace(temp, a.sortie)
    print(f"written: {a.sortie}")


if __name__ == "__main__":
    main()
